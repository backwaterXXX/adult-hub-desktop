            if root.bio != "" : VerticalLayout {
                spacing: 8px;

                bio-compact-text := Text {
                    text: root.bio;
                    font-size: 14px;
                    color: #d6d2db;
                    wrap: word-wrap;
                    overflow: elide;
                    max-lines: root.bio-expanded ? 0 : 5;
                    max-width: 600px;
                }

                if root.bio-expanded || root.has-long-bio : HorizontalLayout {
                    alignment: start;
                    TvSecondaryButton {
                        text: root.bio-expanded ? "Show less ↑" : "Show more ↓";
                        custom-height: 30px;
                        clicked => { root.bio-expanded = !root.bio-expanded; }
                    }
                }
            }

            if root.bio == "" : Text {
                text: root.loading ? "Loading biography…" : "No biography available.";
                font-size: 14px;
                color: HubTheme.text-muted;
            }

            // Absorb leftover height so name, bio and actions stay top-aligned
            // without distributing free space between the content rows.
            Rectangle {
                background: transparent;
                vertical-stretch: 1;
            }
        }
    }
}

component TvChoiceChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    height: 40px;
    border-radius: HubTheme.control-radius;
    background: root.selected ? HubTheme.surface-raised : (root.has-focus || touch.has-hover ? HubTheme.surface-hover : transparent);
    border-width: root.has-focus ? 1px : 0px;
    border-color: root.has-focus ? HubTheme.focus-ring : transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        Text {
            text: root.text;
            color: root.selected || root.has-focus ? HubTheme.text-primary : (touch.has-hover ? HubTheme.text-primary : HubTheme.text-secondary);
            font-size: 13px;
            font-weight: root.selected ? 700 : 500;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 8px;
        y: parent.height - 2px;
        width: parent.width - 16px;
        height: 2px;
        border-radius: 1px;
        background: root.selected ? HubTheme.accent : transparent;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component PerformerLetterChip inherits Rectangle {
    in property <string> letter;
    in property <bool> selected: false;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.letter == "" ? "All performers" : "Performers starting with " + root.letter;
    accessible-action-default => { root.clicked(); }

    width: root.letter == "" ? 44px : 32px;
    height: 32px;
    border-radius: 6px;
    background: root.selected ? HubTheme.accent : (root.has-focus || touch.has-hover ? HubTheme.surface-hover : #1a1a20);
    border-width: root.selected || root.has-focus || touch.has-hover ? 1px : 0px;
    border-color: root.selected ? HubTheme.accent : (root.has-focus ? HubTheme.focus-ring : #BE185D44);

    Text {
        text: root.letter == "" ? "ALL" : root.letter;
        color: root.selected || root.has-focus || touch.has-hover ? HubTheme.text-primary : #99959f;
        font-size: 13px;
        font-weight: root.selected ? 700 : 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}


component PlayerTimeline inherits Rectangle {
    in property <float> value: 0;
    in property <float> maximum: 1;
    in property <bool> enabled: true;
    callback seek(float);
    callback activity();
    callback dragging(bool);

    out property <bool> has-focus: focus-scope.has-focus;
    forward-focus: focus-scope;
    accessible-role: slider;
    accessible-value: "" + Math.round(root.effective-val);

    height: 24px;
    clip: false;

    private property <bool> is-dragging: false;
    private property <float> drag-val: 0;
    private property <float> hover-val: 0;
    private property <bool> is-hovered: touch.has-hover;
    private property <length> hover-x: 0px;

    private property <float> effective-val: root.is-dragging ? root.drag-val : root.value;
    private property <float> progress: root.maximum > 0.001 ? Math.max(0.0, Math.min(1.0, root.effective-val / root.maximum)) : 0.0;
    private property <length> track-height: (root.is-hovered || root.is-dragging || root.has-focus) ? 6px : 4px;

    animate track-height { duration: 100ms; }

    // Track Background (Dark with subtle border)
    Rectangle {
        y: (parent.height - root.track-height) / 2;
        x: 0px;
        width: 100%;
        height: root.track-height;
        border-radius: root.track-height / 2;
        background: #3A3D48CC;
        border-width: 0.5px;
        border-color: #FFFFFF15;
    }

    // Played Progress Bar (Accent color with gradient)
    Rectangle {
        y: (parent.height - root.track-height) / 2;
        x: 0px;
        width: Math.max(0px, Math.min(parent.width, parent.width * root.progress));
        height: root.track-height;
        border-radius: root.track-height / 2;
        background: @linear-gradient(90deg, #E02874 0%, HubTheme.accent 100%);
    }

    // Scrub Handle / Thumb
    Rectangle {
        x: Math.max(0px, Math.min(parent.width - self.width, (parent.width * root.progress) - (self.width / 2)));
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: #FFFFFF;
        border-width: 3px;
        border-color: HubTheme.accent;
        opacity: (root.is-hovered || root.is-dragging || root.has-focus) ? 1.0 : 0.0;
        visible: root.enabled && (root.is-hovered || root.is-dragging || root.has-focus);
        animate opacity { duration: 80ms; }
    }

    // Floating Tooltip on Hover / Drag
    if (root.is-hovered || root.is-dragging) && root.maximum > 0.001 : Rectangle {
        property <float> tip-sec: root.is-dragging ? root.drag-val : root.hover-val;
        property <int> total-s: Math.max(0, Math.round(self.tip-sec));
        property <int> mins: Math.floor(self.total-s / 60);
        property <int> secs: self.total-s - self.mins * 60;
        property <string> time-str: (self.mins >= 60
            ? ("" + Math.floor(self.mins / 60) + ":" + (self.mins - Math.floor(self.mins / 60) * 60 < 10 ? "0" : "") + (self.mins - Math.floor(self.mins / 60) * 60))
            : ("" + self.mins))
            + ":" + (self.secs < 10 ? "0" : "") + self.secs;

        x: Math.max(0px, Math.min(parent.width - self.width, root.hover-x - (self.width / 2)));
        y: -30px;
        width: 56px;
        height: 24px;
        border-radius: 4px;
        background: #111216F0;
        border-width: 1px;
        border-color: HubTheme.accent-outline;

        Text {
            width: 100%;
            height: 100%;
            text: parent.time-str;
            color: HubTheme.text-primary;
            font-size: 11px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            root.activity();
            root.hover-x = self.mouse-x;
            root.hover-val = Math.max(0.0, Math.min(root.maximum, (self.mouse-x / root.width) * root.maximum));
            if (event.kind == PointerEventKind.down) {
                root.is-dragging = true;
                root.drag-val = root.hover-val;
                root.dragging(true);
            } else if (event.kind == PointerEventKind.up) {
                if (root.is-dragging) {
                    root.seek(root.drag-val);
                    root.is-dragging = false;
                    root.dragging(false);
                }
            } else if (event.kind == PointerEventKind.cancel) {
                root.is-dragging = false;
                root.dragging(false);
            }
        }
        moved => {
            root.activity();
            root.hover-x = self.mouse-x;
            root.hover-val = Math.max(0.0, Math.min(root.maximum, (self.mouse-x / root.width) * root.maximum));
            if (self.pressed) {
                root.is-dragging = true;
                root.drag-val = root.hover-val;
                root.dragging(true);
            }
        }
        clicked => {
            root.activity();
            let click-val = Math.max(0.0, Math.min(root.maximum, (self.mouse-x / root.width) * root.maximum));
            root.seek(click-val);
            root.is-dragging = false;
            root.dragging(false);
        }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            root.activity();
            if (event.text == Key.LeftArrow) {
                root.seek(Math.max(0.0, root.value - 10.0));
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.seek(Math.min(root.maximum, root.value + 10.0));
                return accept;
            }
            if (event.text == Key.Home) {
                root.seek(0.0);
                return accept;
            }
            if (event.text == Key.End) {
                root.seek(root.maximum);
                return accept;
            }
            reject
        }
    }
}

component HomeFeaturedHero inherits Rectangle {
    in property <VideoCardData> item;
    in property <bool> is-resume: false;
    in property <bool> has-item: false;
    callback play(string);
    callback open-detail(string);

    property <bool> has-graphic: root.has-item && root.item.has_thumbnail;

    // With artwork the hero is a fixed cinematic band; without artwork it
    // shrinks to the content instead of showing a huge empty banner, and it
    // never grows with the window height.
    preferred-height: root.has-graphic
        ? ((root.is-resume && root.item.progress > 0.0) ? 280px : 248px)
        : hero-content.preferred-height;
    height: root.has-item ? self.preferred-height : 0px;
    border-radius: HubTheme.dialog-radius;
    background: HubTheme.surface-raised;
    clip: true;

    // Right-aligned backdrop artwork with cinematic fade
    if root.has-graphic : Rectangle {
        x: parent.width - self.width;
        y: 0px;
        width: min(parent.width * 0.62, 540px);
        height: 100%;
        clip: true;

        Image {
            source: root.item.thumbnail;
            width: 100%;
            height: 100%;
            image-fit: cover;
        }

        // Gradient overlay to guarantee high text contrast on left
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(90deg, HubTheme.surface-raised 0%, HubTheme.surface-raised 38%, #1C1E24D9 65%, #1C1E2410 100%);
        }
    }

    // Left content area - strictly starts at left edge
    hero-content := VerticalLayout {
        x: 0px;
        padding-left: root.has-graphic ? 28px : 24px;
        padding-right: 24px;
        padding-top: 24px;
        padding-bottom: 24px;
        spacing: 10px;
        alignment: start;
        width: root.has-graphic ? min(parent.width * 0.65, 620px) : parent.width;
        height: root.has-graphic ? parent.height : self.preferred-height;

        // Eyebrow row with discrete indicator
        HorizontalLayout {
            height: 24px;
            spacing: 8px;
            alignment: start;

            Rectangle {
                height: 22px;
                border-radius: 4px;
                background: root.is-resume ? #C2185B28 : #272A32;
                border-width: 1px;
                border-color: root.is-resume ? HubTheme.accent-outline : HubTheme.separator;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;
                    Text {
                        text: root.is-resume ? "CONTINUE WATCHING" : "FEATURED";
                        color: root.is-resume ? HubTheme.accent-text : HubTheme.text-secondary;
                        font-size: 10px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }

            if root.item.studio != "" : Text {
                text: "· " + root.item.studio;
                color: HubTheme.text-muted;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Title: bold, left-aligned, max 2 lines with elide
        Text {
            text: root.item.title;
            color: HubTheme.text-primary;
            font-size: 24px;
            font-weight: 700;
            horizontal-alignment: left;
            vertical-alignment: top;
            wrap: word-wrap;
            overflow: elide;
            width: 100%;
            height: 58px;
        }

        // Metadata row: duration, year, genre
        HorizontalLayout {
            height: 18px;
            spacing: 8px;
            alignment: start;

            if root.item.duration != "" : Text {
                text: root.item.duration;
                color: HubTheme.text-secondary;
                font-size: HubTheme.body-size;
                font-weight: 500;
                vertical-alignment: center;
            }

            if root.item.year != "" : Text {
                text: "· " + root.item.year;
                color: HubTheme.text-secondary;
                font-size: HubTheme.body-size;
                vertical-alignment: center;
            }

            if root.item.genre != "" : Text {
                text: "· " + root.item.genre;
                color: HubTheme.text-muted;
                font-size: HubTheme.body-size;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        // Progress bar for resume item - separated from interactive timeline
        if root.is-resume && root.item.progress > 0.0 && root.item.progress < 0.95 : VerticalLayout {
            spacing: 4px;

            Text {
                text: "Resume playback · " + round(root.item.progress * 100.0) + "% completed";
                color: HubTheme.accent-text;
                font-size: 11px;
                font-weight: 600;
            }

            Rectangle {
                width: 240px;
                height: 4px;
                border-radius: 2px;
                background: #30333C;
                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * max(0.0, min(1.0, root.item.progress));
                    height: 100%;
                    border-radius: 2px;
                    background: HubTheme.accent;
                }
            }
        }

        // Action buttons row
        HorizontalLayout {
            spacing: 12px;
            alignment: start;

            TvPrimaryButton {
                text: root.is-resume ? "Resume" : "Play";
                custom-height: 40px;
                clicked => { root.play(root.item.id); }
            }

            TvSecondaryButton {
                text: "Details";
                custom-height: 40px;
                clicked => { root.open-detail(root.item.id); }
            }
        }
    }
}

component CatalogGridCard inherits Rectangle {
    in property <VideoCardData> card;
    in property <length> card-width: 250px;
    in property <int> focused-index: -1;
    callback open-performer(string);
    callback open-studio(string);
    callback open-category(string);
    callback play(string);
    callback open-detail(string);
    callback retry-thumbnail(VideoCardData);

    width: root.card-width;
    preferred-width: root.card-width;
    height: root.card.provider == "performer" ? (root.card-width * 1.35 + 58px) :
            (root.card.provider == "studio" ? (min(140px, root.card-width * 0.5) + 64px) :
            ((root.card.provider == "genre" || root.card.provider == "category") ? (min(120px, root.card-width * 0.45) + 56px) :
            (min(220px, root.card-width * 0.5625) + 70px)));

    if root.card.provider == "performer" : PerformerCard {
        width: 100%;
        height: 100%;
        card-width: root.card-width;
        item: root.card;
        is-focused: root.focused-index == root.card.card-index;
        clicked => { root.open-performer(root.card.title); }
    }
    if root.card.provider == "studio" : StudioCard {
        width: 100%;
        height: 100%;
        card-width: root.card-width;
        item: root.card;
        is-focused: root.focused-index == root.card.card-index;
        clicked => { root.open-studio(root.card.title); }
    }
    if root.card.provider == "genre" || root.card.provider == "category" : CategoryCard {
        width: 100%;
        height: 100%;
        card-width: root.card-width;
        item: root.card;
        is-focused: root.focused-index == root.card.card-index;
        clicked => { root.open-category(root.card.title); }
    }
    if root.card.provider != "performer" && root.card.provider != "studio" && root.card.provider != "genre" && root.card.provider != "category" : VideoCard {
        width: 100%;
        height: 100%;
        card-width: root.card-width;
        fixed-width: true;
        item: root.card;
        is-focused: root.focused-index == root.card.card-index;
        play => { root.play(root.card.id); }
        open-detail => { root.open-detail(root.card.id); }
        thumbnail-retry(item) => { root.retry-thumbnail(item); }
    }
}

export component MainWindow inherits Window {
    in-out property <string> app-version: "0.2.0";
    in-out property <string> app-version-details: "";
    title: "Adult Hub Desktop";
    icon: @image-url("../../../assets/adult-hub-desktop.png");
    in-out property <length> window-target-width: 1180px;
    in-out property <length> window-target-height: 760px;
    preferred-width: root.window-target-width;
    preferred-height: root.window-target-height;
    min-width: 800px;
    min-height: 520px;
    background: HubTheme.app-background;
    default-font-family: "Segoe UI Variable";
    forward-focus: keys;

    in-out property <string> player-error-details: "";
    in-out property <bool> player-error-details-visible: false;
    in-out property <string> saved-resolver-url: "";
    in-out property <bool> resolver-url-dirty: false;
    in-out property <int> cache-limit-mb: 1024;
    in-out property <string> cache-usage-text: "";
    callback set-cache-limit-mb(int);
    callback refresh-cache-size();

    // View state: "browse", "player", "settings" / "login"
    in-out property <string> active-screen: "home";
    in-out property <string> settings-section: "connection";
    in-out property <bool> is-fullscreen: false;
    in-out property <bool> nav-collapsed: false;

    // Player state
    in-out property <image> video-image;
    in-out property <float> position: 0;
    in-out property <float> duration: 0;
    in-out property <bool> playing: false;
    in-out property <bool> player-media-loaded: false;
    in-out property <bool> has-active-media: false;
    in-out property <string> player-title: "";
    in-out property <string> player-subtitle: "";
    in-out property <string> player-state: "idle"; // "idle", "resolving", "loading", "buffering", "playing", "paused", "failed"
    in-out property <string> player-loading-message: "";
    in-out property <bool> player-controls-visible: true;
    in-out property <bool> player-timeline-dragging: false;
    in-out property <bool> browse-nav-expanded: true;
    in-out property <bool> browse-subnav-menu-open: false;
    in-out property <bool> player-more-controls-visible: false;
    in-out property <bool> player-advanced-controls-visible: false;
    in-out property <string> seek-feedback: "";
    in-out property <bool> player-is-favorite: false;
    in-out property <bool> player-favorite-enabled: false;
    in-out property <bool> hud-visible: false;
    in-out property <bool> muted: false;
    in-out property <string> hud-text: "";
    in-out property <string> status: "Ready";
    in-out property <color> status-color: HubTheme.text-secondary;
    in-out property <string> last-content-screen: "home";
    in-out property <string> player-error-message: "";
    in-out property <string> url-text: "";
    in-out property <float> volume: 100;
    in-out property <string> aspect-label: "Aspect: Auto";
    in-out property <string> position-text: "0:00";
    in-out property <string> duration-text: "0:00";
    in-out property <int> texture-width: 640;
    in-out property <int> texture-height: 360;

    // Download feature state
    in-out property <bool> download-panel-open: false;
    in-out property <string> download-status: "idle"; // "idle", "preparing", "downloading", "paused", "completed", "error"
    in-out property <bool> download-can-pause: false;
    in-out property <string> download-item-id: "";
    in-out property <string> download-title: "";
    in-out property <float> download-progress: 0.0;
    in-out property <bool> download-indeterminate: false;
    in-out property <string> download-bytes-text: "";
    in-out property <string> download-speed-text: "";
    in-out property <string> download-error-text: "";
    in-out property <string> download-file-path: "";
    in-out property <int> download-queue-count: 0;
    in-out property <[DownloadQueueEntry]> download-queue: [];
    in-out property <[DownloadHistoryEntry]> download-history: [];

    // Stage 3 Player Features state
    in-out property <string> speed-label: "1.0x";
    in-out property <string> buffer-profile-label: "Buffer: Standard";
    in-out property <bool> hwdec-active: true;
    in-out property <bool> autoplay-active: false;
    in-out property <bool> playback-ended-visible: false;
    in-out property <int> autoplay-countdown-sec: 0;

    // Browsing & Catalog state
    in-out property <[VideoCardData]> catalog-items: [];
    in-out property <[VideoCardRowData]> catalog-rows: [];
    in-out property <bool> compact-layout: false;
    in-out property <int> catalog-column-count: 3;
    in-out property <int> focused-card-index: -1;
    in-out property <bool> is-loading-catalog: false;
    in-out property <bool> is-loading-more: false;
    in-out property <bool> catalog-has-more: false;
    in-out property <int> catalog-total-count: 0;
    in-out property <string> catalog-more-error: "";
    // Ctrl + wheel card zoom. Session-only: never written to settings, and it
    // starts at 1.0 on every launch.
    in-out property <float> card-zoom: 1.0;
    // Measured widths of the real grid surfaces, used for column math so the
    // catalog, channels and the profile filmographies all share one rule.
    in-out property <length> catalog-content-width: 0px;
    in-out property <length> channel-content-width: 0px;
    in-out property <bool> is-resolving-stream: false;
    in-out property <string> search-query: "";
    in-out property <string> search-focus-target: "catalog";
    in-out property <int> search-focus-sequence: 0;

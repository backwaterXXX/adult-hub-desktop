import { LineEdit, Slider, ListView, ScrollView } from "std-widgets.slint";

export struct VideoCardData {
    id: string,
    title: string,
    duration: string,
    year: string,
    is_played: bool,
    provider: string,
    is_favorite: bool,
    studio: string,
}

export struct DiscoveredServerItem {
    id: string,
    name: string,
    url: string,
}

// Android TV / Mobile Theme Colors:
// NeonPink: #e91e63
// OledBlack: #08080a
// SurfaceDark: #121212
// CardSurface: #1e1e1e
// CardSurfaceFocused: #2a2a2a
// TextPrimary: #e0e0e0
// TextSecondary: #9e9e9e
// TextMuted: #666666

component TvPrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> custom-height: 38px;
    callback clicked();

    height: root.custom-height;
    border-radius: 8px;
    background: !root.enabled ? #2a2a2a : (touch.pressed ? #c2185b : (touch.has-hover ? #ff4081 : #e91e63));
    border-width: touch.has-hover ? 2px : 0px;
    border-color: #ffffff;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        Text {
            text: root.text;
            color: #ffffff;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component TvSecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <length> custom-height: 38px;
    callback clicked();

    height: root.custom-height;
    border-radius: 8px;
    background: root.active ? #e91e6333 : (touch.has-hover ? #2a2a2a : #1e1e1e);
    border-width: root.active ? 2px : (touch.has-hover ? 1.5px : 1px);
    border-color: root.active ? #e91e63 : (touch.has-hover ? #e91e6399 : #ffffff1f);

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: root.active ? #ffffff : (touch.has-hover ? #ffffff : #e0e0e0);
            font-size: 13px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component TvChoiceChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();

    height: 34px;
    border-radius: 17px;
    background: root.selected ? #e91e63 : (touch.has-hover ? #2a2a2a : #1e1e1e);
    border-width: 1px;
    border-color: root.selected ? #e91e63 : (touch.has-hover ? #e91e6388 : #ffffff1f);

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        Text {
            text: root.text;
            color: root.selected ? #ffffff : (touch.has-hover ? #ffffff : #9e9e9e);
            font-size: 13px;
            font-weight: root.selected ? 700 : 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SeekBar inherits Rectangle {
    in property <float> value: 0;
    in property <float> maximum: 1;
    callback seek(float);

    height: 8px;
    border-radius: 4px;
    background: #1e1e28;
    clip: false;

    // Played progress fill (NeonPink)
    Rectangle {
        x: 0;
        y: 0;
        height: 100%;
        width: root.maximum > 0 ? max(0px, min(root.width, root.width * root.value / root.maximum)) : 0px;
        border-radius: 4px;
        background: #e91e63;
    }

    // Scrub thumb
    Rectangle {
        x: root.maximum > 0 ? max(0px, min(root.width - 14px, (root.width * root.value / root.maximum) - 7px)) : 0px;
        y: -4px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        border-width: 2px;
        border-color: #e91e63;
        visible: touch.has-hover || touch.pressed;
    }

    touch := TouchArea {
        clicked => {
            root.seek(root.maximum * (self.mouse-x / root.width));
        }
        moved => {
            if (self.pressed) {
                root.seek(root.maximum * (self.mouse-x / root.width));
            }
        }
    }
}

component MovieCardItem inherits Rectangle {
    in property <VideoCardData> item;
    callback play();
    callback open-detail();

    height: 104px;
    border-radius: 10px;
    background: touch.has-hover ? #2a2a2a : #1e1e1e;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? #e91e63 : #ffffff1f;
    clip: true;

    touch := TouchArea {
        clicked => { root.open-detail(); }
    }

    HorizontalLayout {
        padding: 8px;
        spacing: 16px;

        // 16:9 Thumbnail preview container
        Rectangle {
            width: 156px;
            height: 88px;
            border-radius: 6px;
            background: #121212;
            clip: true;

            // Subtle gradient background
            Rectangle {
                width: 100%;
                height: 100%;
                background: @linear-gradient(135deg, #24242d 0%, #121212 100%);
            }

            // Center play icon glyph
            Text {
                text: "▶";
                color: touch.has-hover ? #e91e63 : #ffffff55;
                font-size: 26px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Top-left provider badge
            Rectangle {
                x: 6px;
                y: 6px;
                height: 18px;
                border-radius: 4px;
                background: #000000b3;
                border-width: 1px;
                border-color: root.item.provider == "telegram" ? #29b6f6 : (root.item.provider == "local" ? #8bc34a : #e91e63);

                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text {
                        text: root.item.provider == "telegram" ? "TG" : (root.item.provider == "local" ? "LOCAL" : "JF");
                        color: root.item.provider == "telegram" ? #29b6f6 : (root.item.provider == "local" ? #8bc34a : #e91e63);
                        font-size: 9px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                }
            }

            // Top-right status badges
            HorizontalLayout {
                x: parent.width - self.width - 6px;
                y: 6px;
                spacing: 4px;

                if root.item.is_favorite : Rectangle {
                    height: 18px;
                    border-radius: 4px;
                    background: #e91e63e6;
                    HorizontalLayout {
                        padding-left: 4px;
                        padding-right: 4px;
                        Text {
                            text: "❤️";
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                    }
                }

                if root.item.is_played : Rectangle {
                    height: 18px;
                    border-radius: 4px;
                    background: #000000c7;
                    border-width: 1px;
                    border-color: #e91e63;

                    HorizontalLayout {
                        padding-left: 5px;
                        padding-right: 5px;
                        Text {
                            text: "WATCHED";
                            color: #e91e63;
                            font-size: 9px;
                            font-weight: 800;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Bottom-right Duration badge
            if root.item.duration != "" : Rectangle {
                x: parent.width - self.width - 6px;
                y: parent.height - self.height - 6px;
                height: 18px;
                border-radius: 4px;
                background: #1a1a1acc;

                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text {
                        text: root.item.duration;
                        color: #e0e0e0;
                        font-size: 10px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Details column
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;

            Text {
                text: root.item.title;
                color: touch.has-hover ? #ffffff : #e0e0e0;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 8px;

                if root.item.year != "" : Text {
                    text: root.item.year;
                    color: #9e9e9e;
                    font-size: 12px;
                }

                if root.item.year != "" : Text {
                    text: "•";
                    color: #666666;
                    font-size: 12px;
                }

                Text {
                    text: root.item.provider == "telegram" ? "Telegram Video" : (root.item.provider == "local" ? "Local Video" : "Jellyfin Video");
                    color: #9e9e9e;
                    font-size: 12px;
                }

                if root.item.studio != "" : Text {
                    text: "• " + root.item.studio;
                    color: #ff80ab;
                    font-size: 12px;
                    font-weight: 600;
                }
            }
        }

        // Circular play button
        HorizontalLayout {
            alignment: center;
            padding-right: 8px;

            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: play-touch.has-hover ? #e91e63 : #2a2a2a;
                border-width: 1px;
                border-color: play-touch.has-hover ? #ffffff : #ffffff22;

                Text {
                    text: "▶";
                    color: #ffffff;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                play-touch := TouchArea {
                    clicked => { root.play(); }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Adult Hub Desktop";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 800px;
    min-height: 520px;
    background: #08080a;
    default-font-family: "Segoe UI";
    forward-focus: keys;

    // View state: "browse", "player", "settings" / "login"
    in-out property <string> active-screen: "browse";

    // Player state
    in-out property <image> video-image;
    in-out property <float> position: 0;
    in-out property <float> duration: 0;
    in-out property <bool> playing: false;
    in-out property <bool> hud-visible: false;
    in-out property <bool> muted: false;
    in-out property <string> hud-text: "";
    in-out property <string> status: "Ready";
    in-out property <color> status-color: #9e9e9e;
    in-out property <string> url-text: "";
    in-out property <float> volume: 100;
    in-out property <string> aspect-label: "Aspect: Auto";
    in-out property <string> position-text: "0:00";
    in-out property <string> duration-text: "0:00";
    in-out property <int> texture-width: 640;
    in-out property <int> texture-height: 360;

    // Stage 3 Player Features state
    in-out property <string> speed-label: "1.0x";
    in-out property <string> buffer-profile-label: "Buffer: Standard";
    in-out property <bool> hwdec-active: true;
    in-out property <bool> autoplay-active: false;
    in-out property <bool> resume-prompt-visible: false;
    in-out property <string> resume-prompt-time: "0:00";
    in-out property <float> resume-prompt-position: 0;

    // Browsing & Catalog state
    in-out property <[VideoCardData]> catalog-items: [];
    in-out property <string> search-query: "";
    in-out property <string> active-category: "Latest";
    in-out property <string> current-library: "All Videos";

    // Auth & Settings state
    in-out property <string> server-url-input: "http://localhost:8096";
    in-out property <string> username-input: "";
    in-out property <string> password-input: "";
    in-out property <string> quick-connect-code: "";
    in-out property <string> logged-in-user: "";
    in-out property <bool> is-logged-in: false;

    // Callbacks
    callback switch-screen(string);
    callback toggle-play();
    callback seek-to(float);
    callback seek-relative(float);
    callback set-volume(float);
    callback load-url(string);
    callback open-file();
    callback load-sample();
    callback cycle-aspect();
    callback toggle-hud();
    callback toggle-mute();
    callback toggle-fullscreen();
    callback escape-pressed();

    // Catalog & Auth Callbacks
    callback perform-login(string, string, string);
    callback perform-logout();
    callback start-quick-connect();
    callback cancel-quick-connect();
    callback search-catalog(string);
    callback filter-category(string);
    callback play-item(string);

    // Stage 3 Playback Callbacks
    callback cycle-speed();
    callback cycle-buffer-profile();
    callback toggle-hwdec();
    callback toggle-autoplay();
    callback play-random();
    callback accept-resume();
    callback reject-resume();

    // Stage 4 Desktop & Settings Callbacks
    callback panic-exit();
    callback clear-search-history();
    callback clear-progress-history();

    // Stage 4 Settings & Feature State
    in-out property <string> resolver-url-input: "";
    in-out property <string> seek-step-label: "Seek: 15s";
    in-out property <int> seek-step-sec: 15;
    in-out property <string> cache-limit-label: "Cache Limit: 256 MB";
    in-out property <bool> phash-active: false;
    in-out property <bool> low-ram-active: false;
    in-out property <string> phash-status-text: "";
    in-out property <[string]> excluded-tags-list: [];
    in-out property <[string]> hidden-channels-list: [];
    in-out property <string> new-tag-input: "";
    in-out property <[string]> available-libraries: [];

    // Stage 4 Callbacks
    callback save-resolver-url(string);
    callback test-resolver-connection();
    callback cycle-seek-step();
    callback cycle-cache-limit();
    callback toggle-low-ram();
    callback toggle-phash();
    callback add-excluded-tag(string);
    callback remove-excluded-tag(string);
    callback unhide-all-channels();
    callback clear-image-cache();
    callback export-config();
    callback import-config();
    callback export-diagnostics();
    callback switch-library();

    // Local Server Discovery
    in-out property <[DiscoveredServerItem]> discovered-servers: [];
    in-out property <bool> is-scanning-servers: false;
    callback scan-servers();
    callback select-discovered-server(string);

    // Stage 5 Update State & Callbacks
    in-out property <string> app-version: "0.1.0";
    in-out property <bool> auto-update-enabled: true;
    in-out property <string> update-status: "";
    in-out property <bool> update-available: false;
    in-out property <string> update-version: "";
    in-out property <string> update-release-notes: "";
    in-out property <bool> update-downloading: false;
    in-out property <float> update-progress: 0.0;
    in-out property <bool> update-ready: false;

    callback toggle-auto-update();
    callback check-for-updates();
    callback start-update-download();
    callback install-update();

    // Stage 6 Item Detail & Discovery State
    in-out property <bool> detail-visible: false;
    in-out property <string> detail-id: "";
    in-out property <string> detail-title: "";
    in-out property <string> detail-overview: "";
    in-out property <string> detail-year: "";
    in-out property <string> detail-duration: "";
    in-out property <string> detail-studio: "";
    in-out property <string> detail-genres: "";
    in-out property <string> detail-provider: "";
    in-out property <string> detail-resolution: "";
    in-out property <bool> detail-is-favorite: false;
    in-out property <bool> detail-is-played: false;
    in-out property <string> detail-resume-text: "";
    in-out property <bool> detail-can-resume: false;
    in-out property <[string]> detail-performers: [];

    callback open-item-detail(string);
    callback close-item-detail();
    callback toggle-detail-favorite(string);
    callback toggle-detail-played(string);
    callback play-detail-item(string, bool);
    callback select-performer(string);
    callback select-studio(string);

    // Stage 7 Performer & Studio Profiles & Similar Items
    in-out property <bool> performer-profile-visible: false;
    in-out property <string> performer-name: "";
    in-out property <string> performer-bio: "";
    in-out property <string> performer-nationality: "";
    in-out property <string> performer-birth: "";
    in-out property <string> performer-aliases: "";
    in-out property <[VideoCardData]> performer-items: [];

    callback open-performer-profile(string);
    callback close-performer-profile();

    in-out property <bool> studio-profile-visible: false;
    in-out property <string> studio-name: "";
    in-out property <[VideoCardData]> studio-items: [];

    callback open-studio-profile(string);
    callback close-studio-profile();

    in-out property <[VideoCardData]> detail-similar-items: [];

    // Stage 8 Hierarchical Channels Browser & Telegram Cursor Pagination
    in-out property <[string]> channels-categories: ["All Channels", "4K Studios", "VR Experience", "Highlight Clips", "Exclusive"];
    in-out property <string> active-channel-category: "All Channels";
    in-out property <string> channel-search-query: "";
    in-out property <[VideoCardData]> channel-items: [];
    in-out property <bool> channel-has-more: false;
    in-out property <bool> channel-loading: false;

    callback select-channel-category(string);
    callback load-more-channel-videos();
    callback search-channel-videos(string);

    // Stage 9 HTPC / Gamepad / Remote Navigation & Enhanced Desktop Gestures
    callback video-canvas-clicked();
    callback mouse-scrolled(float);
    callback adjust-volume(float);


    VerticalLayout {
        spacing: 0px;

        // Top Navigation Header (matching Android TV HomeTopBar)
        Rectangle {
            height: 64px;
            background: #0d0d12;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: #ffffff14;
            }

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 16px;
                alignment: center;

                // Logo Brand: ADULT HUB in NeonPink
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    Text {
                        text: "ADULT HUB";
                        color: #e91e63;
                        font-size: 20px;
                        font-weight: 800;
                        letter-spacing: 3px;
                        vertical-alignment: center;
                    }

                    // Library / Platform Badge Pill
                    Rectangle {
                        height: 24px;
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #2a2a2a;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.is-logged-in ? root.logged-in-user : "DESKTOP";
                                color: #9e9e9e;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle { width: 16px; }

                // Navigation Tabs
                TvChoiceChip {
                    text: "Browse";
                    selected: root.active-screen == "browse";
                    clicked => { root.switch-screen("browse"); }
                }

                TvChoiceChip {
                    text: "Channels";
                    selected: root.active-screen == "channels";
                    clicked => { root.switch-screen("channels"); }
                }

                TvChoiceChip {
                    text: "Player";
                    selected: root.active-screen == "player";
                    clicked => { root.switch-screen("player"); }
                }

                TvChoiceChip {
                    text: root.is-logged-in ? "Settings" : "Connect";
                    selected: root.active-screen == "login" || root.active-screen == "settings";
                    clicked => { root.switch-screen("settings"); }
                }

                Rectangle { horizontal-stretch: 1; }

                // Top Actions (Play Random / Surprise Me, Stats, Mute, Fullscreen)
                TvPrimaryButton {
                    text: "Surprise Me";
                    custom-height: 36px;
                    clicked => { root.play-random(); }
                }

                if root.active-screen == "player" : TvSecondaryButton {
                    text: root.hud-visible ? "Hide Stats" : "Stats";
                    active: root.hud-visible;
                    custom-height: 36px;
                    clicked => { root.toggle-hud(); }
                }

                TvSecondaryButton {
                    text: root.muted ? "Unmute" : "Mute";
                    custom-height: 36px;
                    clicked => { root.toggle-mute(); }
                }

                TvSecondaryButton {
                    text: "Fullscreen";
                    custom-height: 36px;
                    clicked => { root.toggle-fullscreen(); }
                }
            }
        }

        // Main Screen Switcher
        Rectangle {
            vertical-stretch: 1;
            background: #08080a;

            // ==========================================
            // 1. BROWSE SCREEN
            // ==========================================
            if root.active-screen == "browse" : VerticalLayout {
                padding: 20px;
                spacing: 16px;

                // Offline / Guest banner
                if !root.is-logged-in : Rectangle {
                    background: #141418;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #ffffff14;
                    height: 44px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        alignment: center;

                        Text {
                            text: "🔒 Offline Mode — Connect your Jellyfin server to access your complete adult library.";
                            color: #9e9e9e;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        TvPrimaryButton {
                            text: "Connect Server";
                            custom-height: 28px;
                            clicked => { root.switch-screen("settings"); }
                        }
                    }
                }

                // Category Filter Chips & Controls Row
                HorizontalLayout {
                    spacing: 10px;
                    height: 36px;

                    TvChoiceChip {
                        text: "Latest";
                        selected: root.active-category == "Latest";
                        clicked => {
                            root.active-category = "Latest";
                            root.filter-category("Latest");
                        }
                    }

                    TvChoiceChip {
                        text: "Resume";
                        selected: root.active-category == "Resume";
                        clicked => {
                            root.active-category = "Resume";
                            root.filter-category("Resume");
                        }
                    }

                    TvChoiceChip {
                        text: "Favorites";
                        selected: root.active-category == "Favorites";
                        clicked => {
                            root.active-category = "Favorites";
                            root.filter-category("Favorites");
                        }
                    }

                    TvChoiceChip {
                        text: "Channels";
                        selected: root.active-category == "Channels";
                        clicked => {
                            root.active-category = "Channels";
                            root.filter-category("Channels");
                        }
                    }

                    TvChoiceChip {
                        text: "Performers";
                        selected: root.active-category == "Performers";
                        clicked => {
                            root.active-category = "Performers";
                            root.filter-category("Performers");
                        }
                    }

                    TvChoiceChip {
                        text: "Studios";
                        selected: root.active-category == "Studios";
                        clicked => {
                            root.active-category = "Studios";
                            root.filter-category("Studios");
                        }
                    }

                    TvChoiceChip {
                        text: "Sample";
                        selected: root.active-category == "Sample";
                        clicked => {
                            root.active-category = "Sample";
                            root.load-sample();
                        }
                    }

                    Rectangle { width: 10px; }

                    TvSecondaryButton {
                        text: "Open File...";
                        custom-height: 34px;
                        clicked => { root.open-file(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Search input
                    LineEdit {
                        width: 280px;
                        text: root.search-query;
                        placeholder-text: "Search videos, cast, channels...";
                        edited(text) => { root.search-query = text; }
                        accepted(text) => {
                            root.search-query = text;
                            root.search-catalog(text);
                        }
                    }

                    TvSecondaryButton {
                        text: "Search";
                        custom-height: 34px;
                        clicked => { root.search-catalog(root.search-query); }
                    }
                }

                // Video Catalog Cards
                ListView {
                    vertical-stretch: 1;

                    for item in root.catalog-items: VerticalLayout {
                        padding-bottom: 10px;
                        MovieCardItem {
                            item: item;
                            play => { root.play-item(item.id); }
                            open-detail => { root.open-item-detail(item.id); }
                        }
                    }
                }

                // Status & Counter Bar
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: root.status;
                        color: root.status-color;
                        font-size: 13px;
                        font-weight: 500;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: root.catalog-items.length + " items";
                        color: #666666;
                        font-size: 12px;
                    }
                }
            }

            // ==========================================
            // 2. CHANNELS SCREEN (Stage 8)
            // ==========================================
            if root.active-screen == "channels" : HorizontalLayout {
                spacing: 0px;

                // Left Sidebar: Categories & Channels
                Rectangle {
                    width: 240px;
                    background: #0d0d12;

                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: 100%;
                        background: #ffffff14;
                    }

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        Text {
                            text: "CHANNELS & CATEGORIES";
                            color: #9e9e9e;
                            font-size: 11px;
                            font-weight: 700;
                            letter-spacing: 1px;
                        }

                        ListView {
                            vertical-stretch: 1;

                            for cat in root.channels-categories : VerticalLayout {
                                padding-bottom: 6px;

                                Rectangle {
                                    height: 38px;
                                    border-radius: 8px;
                                    background: cat == root.active-channel-category ? #e91e6322 : (cat-touch.has-hover ? #1c1c24 : #121216);
                                    border-width: 1px;
                                    border-color: cat == root.active-channel-category ? #e91e63 : (cat-touch.has-hover ? #ffffff22 : transparent);

                                    HorizontalLayout {
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        alignment: center;
                                        spacing: 10px;

                                        Text {
                                            text: "📺";
                                            font-size: 13px;
                                            vertical-alignment: center;
                                        }

                                        Text {
                                            text: cat;
                                            color: cat == root.active-channel-category ? #ffffff : (cat-touch.has-hover ? #ffffff : #cccccc);
                                            font-size: 13px;
                                            font-weight: cat == root.active-channel-category ? 700 : 500;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                            vertical-alignment: center;
                                        }
                                    }

                                    cat-touch := TouchArea {
                                        clicked => {
                                            root.select-channel-category(cat);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Right Section: Channel Videos Content
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 18px;
                    padding-bottom: 18px;
                    spacing: 14px;

                    // Channel Header Bar
                    HorizontalLayout {
                        spacing: 14px;
                        alignment: center;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;

                            Text {
                                text: root.active-channel-category;
                                color: #ffffff;
                                font-size: 20px;
                                font-weight: 700;
                            }

                            Text {
                                text: "Telegram Channel Media Stream • " + root.channel-items.length + " loaded";
                                color: #9e9e9e;
                                font-size: 12px;
                            }
                        }

                        // Search in channel
                        LineEdit {
                            width: 260px;
                            text: root.channel-search-query;
                            placeholder-text: "Search in channel...";
                            edited(text) => { root.channel-search-query = text; }
                            accepted(text) => {
                                root.channel-search-query = text;
                                root.search-channel-videos(text);
                            }
                        }

                        TvSecondaryButton {
                            text: "Search";
                            custom-height: 34px;
                            clicked => { root.search-channel-videos(root.channel-search-query); }
                        }
                    }

                    // Video list in channel
                    ListView {
                        vertical-stretch: 1;

                        for item in root.channel-items : VerticalLayout {
                            padding-bottom: 10px;
                            MovieCardItem {
                                item: item;
                                play => { root.play-item(item.id); }
                                open-detail => { root.open-item-detail(item.id); }
                            }
                        }
                    }

                    // Bottom pagination / loading bar
                    HorizontalLayout {
                        spacing: 12px;
                        alignment: center;

                        if root.channel-loading : Text {
                            text: "Loading channel videos from Telegram...";
                            color: #e91e63;
                            font-size: 13px;
                            font-weight: 600;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        if !root.channel-loading : Text {
                            text: root.channel-items.length + " channel videos";
                            color: #666666;
                            font-size: 12px;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        if root.channel-has-more : TvPrimaryButton {
                            text: "⬇ Load More Telegram Videos";
                            custom-height: 34px;
                            clicked => { root.load-more-channel-videos(); }
                        }
                    }
                }
            }

            // ==========================================
            // 3. PLAYER SCREEN
            // ==========================================
            if root.active-screen == "player" : VerticalLayout {
                spacing: 0px;

                // Video Canvas with OSD Overlays
                Rectangle {
                    vertical-stretch: 1;
                    background: #000000;
                    clip: true;

                    // Embedded mpv OpenGL render target
                    Image {
                        source: root.video-image;
                        image-fit: contain;
                        width: 100%;
                        height: 100%;
                    }

                    video-touch := TouchArea {
                        width: 100%;
                        height: 100%;
                        clicked => {
                            root.video-canvas-clicked();
                        }
                        scroll-event(event) => {
                            root.mouse-scrolled(event.delta-y / 1px);
                            return EventResult.accept;
                        }
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                                root.toggle-hud();
                                return EventResult.accept;
                            }
                            EventResult.reject
                        }
                    }

                    // Top OSD Header
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 52px;
                        background: @linear-gradient(180deg, #000000cc 0%, #00000000 100%);

                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            alignment: center;
                            spacing: 14px;

                            TvSecondaryButton {
                                text: "← Browse";
                                custom-height: 32px;
                                clicked => { root.switch-screen("browse"); }
                            }

                            Text {
                                text: root.status;
                                color: #ffffff;
                                font-size: 14px;
                                font-weight: 600;
                                horizontal-stretch: 1;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            // Decoder Mode Badge
                            Rectangle {
                                height: 24px;
                                border-radius: 12px;
                                background: #1e1e1ecc;
                                border-width: 1px;
                                border-color: root.hwdec-active ? #e91e63 : #666666;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: root.hwdec-active ? "HW DECODE" : "SW DECODE";
                                        color: root.hwdec-active ? #e91e63 : #9e9e9e;
                                        font-size: 10px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Video Matching (pHash) Badge
                            if root.phash-status-text != "" : Rectangle {
                                height: 24px;
                                border-radius: 12px;
                                background: #1e1e1ecc;
                                border-width: 1px;
                                border-color: #29b6f6;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: "🔍 " + root.phash-status-text;
                                        color: #29b6f6;
                                        font-size: 10px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }


                    // Floating Stats HUD
                    if root.hud-visible : Rectangle {
                        x: parent.width - self.width - 20px;
                        y: 64px;
                        width: 440px;
                        height: hud-label.preferred-height + 24px;
                        background: #08080af0;
                        border-radius: 8px;
                        border-width: 1.5px;
                        border-color: #e91e63;

                        VerticalLayout {
                            padding: 12px;

                            hud-label := Text {
                                width: 100%;
                                text: root.hud-text;
                                color: #e0e0e0;
                                font-size: 12px;
                                font-family: "Consolas";
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Floating Resume Prompt Banner
                    if root.resume-prompt-visible : Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 24px;
                        width: 480px;
                        height: 58px;
                        background: #08080af5;
                        border-radius: 10px;
                        border-width: 2px;
                        border-color: #e91e63;

                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 14px;
                            alignment: center;

                            Text {
                                text: "Resume from " + root.resume-prompt-time + "?";
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            TvPrimaryButton {
                                text: "Resume";
                                custom-height: 36px;
                                clicked => { root.accept-resume(); }
                            }

                            TvSecondaryButton {
                                text: "Restart";
                                custom-height: 36px;
                                clicked => { root.reject-resume(); }
                            }
                        }
                    }
                }

                // Bottom Player Controls Panel
                Rectangle {
                    height: 172px;
                    background: #0e0e14;

                    Rectangle {
                        y: 0px;
                        height: 1px;
                        width: 100%;
                        background: #ffffff14;
                    }

                    VerticalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 12px;

                        // Row 1: Time, SeekBar, Duration & Quick Seekers
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;

                            Text {
                                text: root.position-text;
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 600;
                                width: 54px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }

                            SeekBar {
                                horizontal-stretch: 1;
                                value: root.position;
                                maximum: max(0.001, root.duration);
                                seek(value) => { root.seek-to(value); }
                            }

                            Text {
                                text: root.duration-text;
                                color: #9e9e9e;
                                font-size: 13px;
                                font-weight: 500;
                                width: 54px;
                                vertical-alignment: center;
                            }

                            TvSecondaryButton {
                                text: "-" + root.seek-step-sec + "s";
                                custom-height: 30px;
                                clicked => { root.seek-relative(-root.seek-step-sec); }
                            }

                            TvSecondaryButton {
                                text: "+" + root.seek-step-sec + "s";
                                custom-height: 30px;
                                clicked => { root.seek-relative(root.seek-step-sec); }
                            }
                        }


                        // Row 2: Play/Pause, Speed, Buffer, HW Decode, Autoplay, Random, Aspect & Volume
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;

                            TvPrimaryButton {
                                text: root.playing ? "Pause" : "Play";
                                custom-height: 36px;
                                clicked => { root.toggle-play(); }
                            }

                            TvSecondaryButton {
                                text: "Speed: " + root.speed-label;
                                active: root.speed-label != "1.0x";
                                custom-height: 36px;
                                clicked => { root.cycle-speed(); }
                            }

                            TvSecondaryButton {
                                text: root.buffer-profile-label;
                                custom-height: 36px;
                                clicked => { root.cycle-buffer-profile(); }
                            }

                            TvSecondaryButton {
                                text: root.hwdec-active ? "HW: ON" : "HW: OFF";
                                active: root.hwdec-active;
                                custom-height: 36px;
                                clicked => { root.toggle-hwdec(); }
                            }

                            TvSecondaryButton {
                                text: root.autoplay-active ? "Autoplay: ON" : "Autoplay: OFF";
                                active: root.autoplay-active;
                                custom-height: 36px;
                                clicked => { root.toggle-autoplay(); }
                            }

                            TvSecondaryButton {
                                text: "Random Next";
                                custom-height: 36px;
                                clicked => { root.play-random(); }
                            }

                            TvSecondaryButton {
                                text: root.aspect-label;
                                custom-height: 36px;
                                clicked => { root.cycle-aspect(); }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: "Vol";
                                color: #9e9e9e;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            Slider {
                                width: 110px;
                                minimum: 0;
                                maximum: 130;
                                value: root.volume;
                                changed(value) => { root.set-volume(value); }
                            }
                        }

                        // Row 3: Direct URL / Path Load Input
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;

                            LineEdit {
                                horizontal-stretch: 1;
                                text: root.url-text;
                                placeholder-text: "Direct media URL or local video file path...";
                                edited(text) => { root.url-text = text; }
                                accepted(text) => {
                                    root.url-text = text;
                                    root.load-url(text);
                                    keys.focus();
                                }
                            }

                            TvSecondaryButton {
                                text: "Load";
                                custom-height: 34px;
                                clicked => {
                                    root.load-url(root.url-text);
                                    keys.focus();
                                }
                            }
                        }
                    }
                }
            }

            // ==========================================
            // 3. SETTINGS & SERVER SCREEN
            // ==========================================
            if root.active-screen == "login" || root.active-screen == "settings" : ScrollView {
                VerticalLayout {
                    padding: 28px;
                    spacing: 20px;
                    alignment: start;

                    // Header
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Settings & Server Connection";
                            color: #e0e0e0;
                            font-size: 22px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: "Adult Hub Desktop v0.1.0";
                            color: #e91e63;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    // Status notification banner
                    if root.status != "" && root.status != "Ready" : Rectangle {
                        height: 42px;
                        border-radius: 8px;
                        background: #121212;
                        border-width: 1px;
                        border-color: root.status-color;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            Text {
                                text: "✓ " + root.status;
                                color: root.status-color;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Card 1: Server Connection
                    Rectangle {
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #ffffff14;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 16px;

                            Text {
                                text: "Jellyfin Server";
                                color: #e91e63;
                                font-size: 16px;
                                font-weight: 700;
                            }

                            if !root.is-logged-in : VerticalLayout {
                                spacing: 12px;

                                Text {
                                    text: "Server Address (HTTP LAN or HTTPS):";
                                    color: #9e9e9e;
                                    font-size: 13px;
                                }

                                LineEdit {
                                    text: root.server-url-input;
                                    placeholder-text: "http://192.168.1.100:8096 or https://...";
                                    edited(text) => { root.server-url-input = text; }
                                }

                                // Discovered Servers (Android TV style)
                                VerticalLayout {
                                    spacing: 8px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "Discovered Servers:";
                                            color: #e0e0e0;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }

                                        TvSecondaryButton {
                                            text: root.is-scanning-servers ? "Scanning..." : "Scan LAN";
                                            custom-height: 28px;
                                            clicked => { root.scan-servers(); }
                                        }
                                    }

                                    if root.discovered-servers.length > 0 : HorizontalLayout {
                                        spacing: 8px;
                                        for s in root.discovered-servers : Rectangle {
                                            background: s-touch.has-hover ? #2e2e34 : #1c1c22;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: s-touch.has-hover ? #e91e63 : #ffffff22;
                                            height: 32px;

                                            s-touch := TouchArea {
                                                clicked => {
                                                    root.server-url-input = s.url;
                                                    root.select-discovered-server(s.url);
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 6px;
                                                alignment: center;

                                                Text {
                                                    text: "🖥️ " + s.name;
                                                    color: #ffffff;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }

                                                Text {
                                                    text: "(" + s.url + ")";
                                                    color: #9e9e9e;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    if root.discovered-servers.length == 0 : Text {
                                        text: root.is-scanning-servers ? "Scanning local network for Jellyfin servers..." : "No local servers discovered. Enter address manually or click Scan LAN.";
                                        color: #757575;
                                        font-size: 12px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 14px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Text { text: "Username:"; color: #9e9e9e; font-size: 13px; }
                                        LineEdit {
                                            text: root.username-input;
                                            placeholder-text: "Username";
                                            edited(text) => { root.username-input = text; }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Text { text: "Password:"; color: #9e9e9e; font-size: 13px; }
                                        LineEdit {
                                            text: root.password-input;
                                            placeholder-text: "Password";
                                            input-type: password;
                                            edited(text) => { root.password-input = text; }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 14px;
                                    padding-top: 4px;

                                    TvPrimaryButton {
                                        text: "Sign In";
                                        horizontal-stretch: 1;
                                        clicked => {
                                            root.perform-login(
                                                root.server-url-input,
                                                root.username-input,
                                                root.password-input
                                            );
                                        }
                                    }

                                    TvSecondaryButton {
                                        text: "Quick Connect";
                                        horizontal-stretch: 1;
                                        clicked => { root.start-quick-connect(); }
                                    }
                                }

                                if root.quick-connect-code != "" : Rectangle {
                                    background: #121212;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #e91e63;
                                    height: 52px;

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 16px;
                                        padding-left: 16px;
                                        padding-right: 16px;

                                        Text {
                                            text: "Authorize code: " + root.quick-connect-code;
                                            color: #e91e63;
                                            font-size: 18px;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }

                                        TvSecondaryButton {
                                            text: "Cancel";
                                            custom-height: 32px;
                                            clicked => { root.cancel-quick-connect(); }
                                        }
                                    }
                                }
                            }

                            if root.is-logged-in : VerticalLayout {
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 16px;

                                    Rectangle {
                                        width: 50px;
                                        height: 50px;
                                        border-radius: 25px;
                                        background: #e91e6333;
                                        border-width: 2px;
                                        border-color: #e91e63;

                                        Text {
                                            text: "👤";
                                            font-size: 22px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;

                                        Text {
                                            text: root.logged-in-user;
                                            color: #ffffff;
                                            font-size: 18px;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: "Connected to " + root.server-url-input;
                                            color: #9e9e9e;
                                            font-size: 13px;
                                        }
                                    }

                                    TvSecondaryButton {
                                        text: "Log Out";
                                        clicked => { root.perform-logout(); }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 12px;
                                    alignment: center;

                                    Text {
                                        text: "Active Library: " + root.current-library;
                                        color: #e0e0e0;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    TvSecondaryButton {
                                        text: "Switch Library";
                                        custom-height: 32px;
                                        clicked => { root.switch-library(); }
                                    }
                                }
                            }
                        }
                    }

                    // Card 2: Playback & Engine Preferences
                    Rectangle {
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #ffffff14;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 16px;

                            Text {
                                text: "Playback & Engine";
                                color: #e91e63;
                                font-size: 16px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                TvSecondaryButton {
                                    text: root.buffer-profile-label;
                                    horizontal-stretch: 1;
                                    clicked => { root.cycle-buffer-profile(); }
                                }

                                TvSecondaryButton {
                                    text: root.seek-step-label;
                                    horizontal-stretch: 1;
                                    clicked => { root.cycle-seek-step(); }
                                }

                                TvSecondaryButton {
                                    text: root.hwdec-active ? "Hardware Decode: ON" : "Hardware Decode: OFF";
                                    active: root.hwdec-active;
                                    horizontal-stretch: 1;
                                    clicked => { root.toggle-hwdec(); }
                                }
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                TvSecondaryButton {
                                    text: root.autoplay-active ? "Autoplay: ON" : "Autoplay: OFF";
                                    active: root.autoplay-active;
                                    horizontal-stretch: 1;
                                    clicked => { root.toggle-autoplay(); }
                                }

                                TvSecondaryButton {
                                    text: root.low-ram-active ? "Low-RAM Mode: ON" : "Low-RAM Mode: OFF";
                                    active: root.low-ram-active;
                                    horizontal-stretch: 1;
                                    clicked => { root.toggle-low-ram(); }
                                }
                            }
                        }
                    }

                    // Card 3: Resolver API & Video Matching
                    Rectangle {
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #ffffff14;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 14px;

                            Text {
                                text: "Resolver API & Video Matching (pHash)";
                                color: #e91e63;
                                font-size: 16px;
                                font-weight: 700;
                            }

                            Text {
                                text: "Resolver Base URL (for channel catalog and video fingerprint generation):";
                                color: #9e9e9e;
                                font-size: 13px;
                            }

                            HorizontalLayout {
                                spacing: 12px;

                                LineEdit {
                                    horizontal-stretch: 1;
                                    text: root.resolver-url-input;
                                    placeholder-text: "https://resolver.example.com";
                                    edited(text) => { root.resolver-url-input = text; }
                                }

                                TvPrimaryButton {
                                    text: "Save & Test";
                                    custom-height: 38px;
                                    clicked => {
                                        root.save-resolver-url(root.resolver-url-input);
                                        root.test-resolver-connection();
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                TvSecondaryButton {
                                    text: root.phash-active ? "Video Matching (pHash on playback): ON" : "Video Matching (pHash on playback): OFF";
                                    active: root.phash-active;
                                    horizontal-stretch: 1;
                                    clicked => { root.toggle-phash(); }
                                }
                            }
                        }
                    }

                    // Card 4: Cache & Local Storage
                    Rectangle {
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #ffffff14;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 14px;

                            Text {
                                text: "Cache & Local Storage";
                                color: #e91e63;
                                font-size: 16px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                TvSecondaryButton {
                                    text: root.cache-limit-label;
                                    horizontal-stretch: 1;
                                    clicked => { root.cycle-cache-limit(); }
                                }

                                TvSecondaryButton {
                                    text: "Clear Image Cache";
                                    horizontal-stretch: 1;
                                    clicked => { root.clear-image-cache(); }
                                }
                            }
                        }
                    }

                    // Card 5: Content Filters
                    Rectangle {
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #ffffff14;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 14px;

                            Text {
                                text: "Content Filters";
                                color: #e91e63;
                                font-size: 16px;
                                font-weight: 700;
                            }

                            Text {
                                text: "Excluded Tags (hidden from catalog and search):";
                                color: #9e9e9e;
                                font-size: 13px;
                            }

                            HorizontalLayout {
                                spacing: 10px;

                                LineEdit {
                                    horizontal-stretch: 1;
                                    text: root.new-tag-input;
                                    placeholder-text: "Enter tag to exclude...";
                                    edited(text) => { root.new-tag-input = text; }
                                }

                                TvSecondaryButton {
                                    text: "Exclude Tag";
                                    custom-height: 38px;
                                    clicked => {
                                        if (root.new-tag-input != "") {
                                            root.add-excluded-tag(root.new-tag-input);
                                            root.new-tag-input = "";
                                        }
                                    }
                                }
                            }

                            if root.excluded-tags-list.length > 0 : HorizontalLayout {
                                spacing: 8px;
                                for tag in root.excluded-tags-list : Rectangle {
                                    height: 28px;
                                    border-radius: 14px;
                                    background: #2a2a2a;
                                    border-width: 1px;
                                    border-color: #e91e6388;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        alignment: center;

                                        Text {
                                            text: tag;
                                            color: #ffffff;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }

                                        tag-touch := TouchArea {
                                            width: 14px;
                                            height: 14px;
                                            clicked => { root.remove-excluded-tag(tag); }
                                            Text {
                                                text: "✕";
                                                color: tag-touch.has-hover ? #ff4081 : #9e9e9e;
                                                font-size: 11px;
                                                font-weight: 700;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 14px;
                                alignment: center;

                                Text {
                                    text: "Hidden Channels: " + root.hidden-channels-list.length + " channel(s) hidden";
                                    color: #e0e0e0;
                                    font-size: 13px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                if root.hidden-channels-list.length > 0 : TvSecondaryButton {
                                    text: "Unhide All Channels";
                                    custom-height: 32px;
                                    clicked => { root.unhide-all-channels(); }
                                }
                            }
                        }
                    }

                    // Card 6: Configuration & Diagnostics
                    Rectangle {
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #ffffff14;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 14px;

                            Text {
                                text: "Configuration & Diagnostics";
                                color: #e91e63;
                                font-size: 16px;
                                font-weight: 700;
                            }

                            Text {
                                text: "Export non-secret configuration (v1 JSON) or import Android TV settings. Export redacted local diagnostics for troubleshooting.";
                                color: #9e9e9e;
                                font-size: 13px;
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                TvSecondaryButton {
                                    text: "Export Config (JSON)";
                                    horizontal-stretch: 1;
                                    clicked => { root.export-config(); }
                                }

                                TvSecondaryButton {
                                    text: "Import Config (JSON)";
                                    horizontal-stretch: 1;
                                    clicked => { root.import-config(); }
                                }

                                TvSecondaryButton {
                                    text: "Export Diagnostics";
                                    horizontal-stretch: 1;
                                    clicked => { root.export-diagnostics(); }
                                }
                            }
                        }
                    }

                    // Card 7: Data & Privacy
                    Rectangle {
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #ffffff14;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 16px;

                            Text {
                                text: "Data & Privacy";
                                color: #e91e63;
                                font-size: 16px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                TvSecondaryButton {
                                    text: "Clear Search History";
                                    horizontal-stretch: 1;
                                    clicked => { root.clear-search-history(); }
                                }

                                TvSecondaryButton {
                                    text: "Clear Watch History & Progress";
                                    horizontal-stretch: 1;
                                    clicked => { root.clear-progress-history(); }
                                }
                            }
                        }
                    }

                    // Card 8: Emergency Panic Exit
                    Rectangle {
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #ffffff14;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 12px;

                            Text {
                                text: "Panic Exit (Emergency Hide)";
                                color: #e91e63;
                                font-size: 16px;
                                font-weight: 700;
                            }

                            Text {
                                text: "Press Ctrl+Shift+Q anywhere in the application to immediately hide windows, silence audio, and terminate the process.";
                                color: #9e9e9e;
                                font-size: 13px;
                            }

                            HorizontalLayout {
                                TvPrimaryButton {
                                    text: "Panic Exit Now (Ctrl+Shift+Q)";
                                    clicked => { root.panic-exit(); }
                                }
                            }
                        }
                    }

                    // Card 9: Application Updates & Release
                    Rectangle {
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #ffffff14;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 14px;

                            Text {
                                text: "Application Updates & Release";
                                color: #e91e63;
                                font-size: 16px;
                                font-weight: 700;
                            }

                            Text {
                                text: "Adult Hub Desktop " + root.app-version + " (Desktop Edition)";
                                color: #ffffff;
                                font-size: 14px;
                                font-weight: 600;
                            }

                            Text {
                                text: "Manage automatic update checks, review release notes, and install cryptographically verified releases.";
                                color: #9e9e9e;
                                font-size: 13px;
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                TvSecondaryButton {
                                    text: root.auto-update-enabled ? "Auto Update: Enabled" : "Auto Update: Disabled";
                                    active: root.auto-update-enabled;
                                    horizontal-stretch: 1;
                                    clicked => { root.toggle-auto-update(); }
                                }

                                TvPrimaryButton {
                                    text: root.update-downloading ? "Downloading..." : (root.update-ready ? "Install Update Now" : (root.update-available ? "Download Update (" + root.update-version + ")" : "Check for Updates"));
                                    horizontal-stretch: 1;
                                    clicked => {
                                        if (root.update-ready) {
                                            root.install-update();
                                        } else if (root.update-available) {
                                            root.start-update-download();
                                        } else {
                                            root.check-for-updates();
                                        }
                                    }
                                }
                            }

                            if root.update-status != "" : Rectangle {
                                background: #252528;
                                border-radius: 6px;
                                height: 36px;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    Text {
                                        text: root.update-status;
                                        color: #e0e0e0;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            if root.update-release-notes != "" : Text {
                                text: "Release Notes: " + root.update-release-notes;
                                color: #ff80ab;
                                font-size: 12px;
                            }
                        }
                    }
                }
            }
        }
    }

    // Stage 6 Item Detail Modal Dialog (Parity with Android TV DetailScreen)
    if root.detail-visible : Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: #000000e6;

        // Scrim click handler to dismiss when clicking outside dialog
        TouchArea {
            clicked => { root.close-item-detail(); }
        }

        // Dialog Container
        Rectangle {
            width: min(780px, root.width - 48px);
            height: min(540px, root.height - 48px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: 12px;
            background: #141418;
            border-width: 1px;
            border-color: #e91e6388;
            clip: true;

            // Consume clicks inside the dialog so they don't trigger the scrim click
            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // Header Row: Title, Year/Duration/Resolution/Studio Badge & Close Button
                HorizontalLayout {
                    spacing: 16px;
                    alignment: center;

                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;

                        Text {
                            text: root.detail-title;
                            color: #ffffff;
                            font-size: 20px;
                            font-weight: 700;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            if root.detail-year != "" : Text {
                                text: root.detail-year;
                                color: #9e9e9e;
                                font-size: 13px;
                            }

                            if root.detail-duration != "" : Text {
                                text: "•  " + root.detail-duration;
                                color: #9e9e9e;
                                font-size: 13px;
                            }

                            if root.detail-resolution != "" : Text {
                                text: "•  " + root.detail-resolution;
                                color: #9e9e9e;
                                font-size: 13px;
                            }

                            if root.detail-studio != "" : Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: studio-touch.has-hover ? #e91e6333 : #1e1e24;
                                border-width: 1px;
                                border-color: studio-touch.has-hover ? #e91e63 : #ffffff22;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text {
                                        text: root.detail-studio;
                                        color: studio-touch.has-hover ? #ffffff : #ff80ab;
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                studio-touch := TouchArea {
                                    clicked => { root.open-studio-profile(root.detail-studio); }
                                }
                            }
                        }
                    }

                    // Close Button
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: close-touch.has-hover ? #e91e63 : #24242d;

                        Text {
                            text: "✕";
                            color: #ffffff;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        close-touch := TouchArea {
                            clicked => { root.close-item-detail(); }
                        }
                    }
                }

                // Divider line
                Rectangle {
                    height: 1px;
                    background: #ffffff14;
                }

                // Middle Section: Genres, Synopsis / Overview, Performers
                VerticalLayout {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    spacing: 12px;

                    if root.detail-genres != "" : HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "Genres: ";
                            color: #9e9e9e;
                            font-size: 12px;
                            font-weight: 600;
                        }
                        Text {
                            text: root.detail-genres;
                            color: #e0e0e0;
                            font-size: 12px;
                        }
                    }

                    // Synopsis / Overview
                    Flickable {
                        vertical-stretch: 1;
                        interactive: true;

                        Text {
                            width: parent.width;
                            text: root.detail-overview != "" ? root.detail-overview : "No synopsis available.";
                            color: #cccccc;
                            font-size: 13px;
                            wrap: word-wrap;
                        }
                    }

                    // Cast / Performers Pills
                    if root.detail-performers.length > 0 : VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "Performers / Cast:";
                            color: #9e9e9e;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            for performer in root.detail-performers : Rectangle {
                                height: 28px;
                                border-radius: 14px;
                                background: perf-touch.has-hover ? #e91e6333 : #1e1e24;
                                border-width: 1px;
                                border-color: perf-touch.has-hover ? #e91e63 : #ffffff22;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;

                                    Text {
                                        text: performer;
                                        color: perf-touch.has-hover ? #ffffff : #ff80ab;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }

                                perf-touch := TouchArea {
                                    clicked => { root.open-performer-profile(performer); }
                                }
                            }
                        }
                    }

                    // More Like This / Similar Titles
                    if root.detail-similar-items.length > 0 : VerticalLayout {
                        spacing: 6px;

                        Text {
                            text: "More Like This:";
                            color: #9e9e9e;
                            font-size: 12px;
                            font-weight: 600;
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            for sim in root.detail-similar-items : Rectangle {
                                height: 32px;
                                border-radius: 6px;
                                background: sim-touch.has-hover ? #2a2a35 : #1a1a20;
                                border-width: 1px;
                                border-color: sim-touch.has-hover ? #e91e63 : #ffffff1f;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    alignment: center;

                                    Text {
                                        text: "🎬";
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: sim.title;
                                        color: sim-touch.has-hover ? #ffffff : #e0e0e0;
                                        font-size: 12px;
                                        font-weight: 500;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }

                                sim-touch := TouchArea {
                                    clicked => { root.open-item-detail(sim.id); }
                                }
                            }
                        }
                    }
                }

                // Divider line
                Rectangle {
                    height: 1px;
                    background: #ffffff14;
                }

                // Bottom Action Buttons Row
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;

                    TvPrimaryButton {
                        text: root.detail-can-resume ? "▶ Play from Start" : "▶ Play";
                        clicked => { root.play-detail-item(root.detail-id, false); }
                    }

                    if root.detail-can-resume : TvSecondaryButton {
                        text: "Resume (" + root.detail-resume-text + ")";
                        active: true;
                        clicked => { root.play-detail-item(root.detail-id, true); }
                    }

                    TvSecondaryButton {
                        text: root.detail-is-favorite ? "❤️ Favorited" : "🤍 Favorite";
                        active: root.detail-is-favorite;
                        clicked => { root.toggle-detail-favorite(root.detail-id); }
                    }

                    TvSecondaryButton {
                        text: root.detail-is-played ? "✓ Played" : "Mark Watched";
                        active: root.detail-is-played;
                        clicked => { root.toggle-detail-played(root.detail-id); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    TvSecondaryButton {
                        text: "Close";
                        clicked => { root.close-item-detail(); }
                    }
                }
            }
        }
    }

    // ── Performer Profile Dialog (Stage 7) ──────────────────────────────────
    if root.performer-profile-visible : Rectangle {
        z: 95;
        background: #000000b0;

        TouchArea {
            // Absorb clicks on backdrop to close
            clicked => { root.close-performer-profile(); }
        }

        Rectangle {
            width: Math.min(root.width - 80px, 860px);
            height: Math.min(root.height - 80px, 680px);
            background: #14141cf8;
            border-radius: 16px;
            border-width: 1px;
            border-color: #ff336640;
            clip: true;

            TouchArea {
                // Absorb click inside dialog body
            }

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // Header with Performer info
                HorizontalLayout {
                    spacing: 20px;
                    alignment: start;

                    Rectangle {
                        width: 96px;
                        height: 96px;
                        border-radius: 48px;
                        background: #ff336622;
                        border-width: 2px;
                        border-color: #ff3366;

                        Text {
                            text: "★";
                            font-size: 36px;
                            color: #ff3366;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: root.performer-name;
                            font-size: 24px;
                            font-weight: 700;
                            color: #ffffff;
                        }

                        HorizontalLayout {
                            spacing: 12px;
                            if root.performer-nationality != "" : Text {
                                text: "🌍 " + root.performer-nationality;
                                font-size: 13px;
                                color: #ff99bb;
                            }
                            if root.performer-birth != "" : Text {
                                text: "🎂 " + root.performer-birth;
                                font-size: 13px;
                                color: #888899;
                            }
                        }

                        if root.performer-aliases != "" : Text {
                            text: "AKA: " + root.performer-aliases;
                            font-size: 12px;
                            color: #aaaaaa;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    TvSecondaryButton {
                        text: "✕ Close";
                        clicked => { root.close-performer-profile(); }
                    }
                }

                // Biography snippet
                if root.performer-bio != "" : Rectangle {
                    background: #ffffff0a;
                    border-radius: 8px;
                    max-height: 100px;
                    clip: true;

                    VerticalLayout {
                        padding: 12px;
                        Text {
                            text: root.performer-bio;
                            font-size: 13px;
                            color: #dddddd;
                            wrap: word-wrap;
                        }
                    }
                }

                // Filmography title
                HorizontalLayout {
                    Text {
                        text: "Filmography / Videos (" + root.performer-items.length + ")";
                        font-size: 16px;
                        font-weight: 600;
                        color: #ff99bb;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                // Filmography list
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 8px;

                        for item in root.performer-items : Rectangle {
                            height: 64px;
                            background: item-hover.has-hover ? #ff336622 : #ffffff08;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: item-hover.has-hover ? #ff336666 : transparent;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 14px;
                                alignment: center;

                                Rectangle {
                                    width: 80px;
                                    height: 48px;
                                    border-radius: 4px;
                                    background: #00000066;
                                    clip: true;

                                    Text {
                                        text: "▶";
                                        font-size: 18px;
                                        color: #ffffff88;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    alignment: center;

                                    Text {
                                        text: item.title;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #ffffff;
                                        overflow: elide;
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        if item.year != "" : Text {
                                            text: item.year;
                                            font-size: 12px;
                                            color: #888899;
                                        }
                                        if item.duration != "" : Text {
                                            text: item.duration;
                                            font-size: 12px;
                                            color: #ffcc00;
                                        }
                                        if item.studio != "" : Text {
                                            text: item.studio;
                                            font-size: 12px;
                                            color: #ff99bb;
                                            overflow: elide;
                                        }
                                    }
                                }

                                TvPrimaryButton {
                                    text: "▶ Play";
                                    clicked => {
                                        root.close-performer-profile();
                                        root.play-detail-item(item.id, false);
                                    }
                                }

                                TvSecondaryButton {
                                    text: "Details";
                                    clicked => {
                                        root.close-performer-profile();
                                        root.open-item-detail(item.id);
                                    }
                                }
                            }

                            item-hover := TouchArea {
                                clicked => {
                                    root.close-performer-profile();
                                    root.open-item-detail(item.id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ── Studio Profile Dialog (Stage 7) ─────────────────────────────────────
    if root.studio-profile-visible : Rectangle {
        z: 95;
        background: #000000b0;

        TouchArea {
            clicked => { root.close-studio-profile(); }
        }

        Rectangle {
            width: Math.min(root.width - 80px, 860px);
            height: Math.min(root.height - 80px, 680px);
            background: #14141cf8;
            border-radius: 16px;
            border-width: 1px;
            border-color: #ff663340;
            clip: true;

            TouchArea {}

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // Header with Studio info
                HorizontalLayout {
                    spacing: 20px;
                    alignment: start;

                    Rectangle {
                        width: 96px;
                        height: 96px;
                        border-radius: 12px;
                        background: #ff663322;
                        border-width: 2px;
                        border-color: #ff6633;

                        Text {
                            text: "🏢";
                            font-size: 36px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        alignment: center;

                        Text {
                            text: root.studio-name;
                            font-size: 24px;
                            font-weight: 700;
                            color: #ffffff;
                        }

                        Text {
                            text: "Studio Catalog & Releases";
                            font-size: 13px;
                            color: #ffaa88;
                        }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    TvSecondaryButton {
                        text: "✕ Close";
                        clicked => { root.close-studio-profile(); }
                    }
                }

                // Studio catalog title
                HorizontalLayout {
                    Text {
                        text: "Releases (" + root.studio-items.length + ")";
                        font-size: 16px;
                        font-weight: 600;
                        color: #ffaa88;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                // Studio items list
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 8px;

                        for item in root.studio-items : Rectangle {
                            height: 64px;
                            background: studio-item-hover.has-hover ? #ff663322 : #ffffff08;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: studio-item-hover.has-hover ? #ff663366 : transparent;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 14px;
                                alignment: center;

                                Rectangle {
                                    width: 80px;
                                    height: 48px;
                                    border-radius: 4px;
                                    background: #00000066;
                                    clip: true;

                                    Text {
                                        text: "▶";
                                        font-size: 18px;
                                        color: #ffffff88;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    alignment: center;

                                    Text {
                                        text: item.title;
                                        font-size: 14px;
                                        font-weight: 600;
                                        color: #ffffff;
                                        overflow: elide;
                                    }

                                    HorizontalLayout {
                                        spacing: 10px;
                                        if item.year != "" : Text {
                                            text: item.year;
                                            font-size: 12px;
                                            color: #888899;
                                        }
                                        if item.duration != "" : Text {
                                            text: item.duration;
                                            font-size: 12px;
                                            color: #ffcc00;
                                        }
                                    }
                                }

                                TvPrimaryButton {
                                    text: "▶ Play";
                                    clicked => {
                                        root.close-studio-profile();
                                        root.play-detail-item(item.id, false);
                                    }
                                }

                                TvSecondaryButton {
                                    text: "Details";
                                    clicked => {
                                        root.close-studio-profile();
                                        root.open-item-detail(item.id);
                                    }
                                }
                            }

                            studio-item-hover := TouchArea {
                                clicked => {
                                    root.close-studio-profile();
                                    root.open-item-detail(item.id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            // Panic Exit: Ctrl+Shift+Q
            if (event.modifiers.control && event.modifiers.shift && (event.text == "q" || event.text == "Q")) {
                root.panic-exit();
                return accept;
            }

            // Quick navigation (Stage 9)
            if (event.text == "1") {
                root.switch-screen("browse");
                return accept;
            }
            if (event.text == "2") {
                root.switch-screen("channels");
                return accept;
            }
            if (event.text == "3") {
                root.switch-screen("player");
                return accept;
            }
            if (event.text == "4") {
                root.switch-screen("settings");
                return accept;
            }

            // Player controls (Stage 9)
            if (event.text == Key.Space) {
                root.toggle-play();
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.adjust-volume(5.0);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.adjust-volume(-5.0);
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.seek-relative(-root.seek-step-sec);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.seek-relative(root.seek-step-sec);
                return accept;
            }
            if (event.text == "[" || event.text == "{") {
                root.seek-relative(-30.0);
                return accept;
            }
            if (event.text == "]" || event.text == "}") {
                root.seek-relative(30.0);
                return accept;
            }
            if (event.text == "f" || event.text == "F") {
                root.toggle-fullscreen();
                return accept;
            }
            if (event.text == "i" || event.text == "I") {
                root.toggle-hud();
                return accept;
            }
            if (event.text == "m" || event.text == "M" || event.text == "0") {
                root.toggle-mute();
                return accept;
            }
            if (event.text == "s" || event.text == "S" || event.text == "," || event.text == "<") {
                root.cycle-speed();
                return accept;
            }
            if (event.text == "b" || event.text == "B") {
                root.cycle-buffer-profile();
                return accept;
            }
            if (event.text == "h" || event.text == "H") {
                root.toggle-hwdec();
                return accept;
            }
            if (event.text == "n" || event.text == "N") {
                root.play-random();
                return accept;
            }
            if (event.text == Key.Escape) {
                // Hierarchical dismiss
                if (root.performer-profile-visible) {
                    root.close-performer-profile();
                    return accept;
                }
                if (root.studio-profile-visible) {
                    root.close-studio-profile();
                    return accept;
                }
                if (root.detail-visible) {
                    root.close-item-detail();
                    return accept;
                }
                root.escape-pressed();
                return accept;
            }
            reject
        }
    }
}


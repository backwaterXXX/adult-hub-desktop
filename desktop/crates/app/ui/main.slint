    in-out property <bool> performer-bio-long: false;
    in-out property <[VideoCardData]> home-resume-items: [];
    in-out property <[VideoCardData]> home-history-items: [];
    in-out property <[VideoCardData]> home-latest-items: [];
    in-out property <[VideoCardData]> home-random-items: [];
    in-out property <[VideoCardData]> home-performer-items: [];
    in-out property <[HomeCategoryOption]> home-category-options: [];
    in-out property <[HomeCategoryShelfData]> home-category-shelves: [];
    in-out property <bool> home-random-unwatched-only: false;
    in-out property <bool> home-is-loading: false;
    in-out property <string> home-error-message: "";
    in-out property <string> home-resume-error: "";

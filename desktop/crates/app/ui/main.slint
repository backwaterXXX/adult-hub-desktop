import { ListView, ScrollView } from "std-widgets.slint";
import { VideoCard, VideoCardData, VideoCardRowData } from "VideoCard.slint";
import { DashboardShelf, PerformerCard, StudioCard, CategoryCard } from "DashboardShelf.slint";
import { Toast } from "Toast.slint";
import { HubTheme, KeyboardState } from "theme.slint";
import { Button, IconButton, FilterIconButton, LoadingState, PageHeader, AccentSpinner, WheelZoomCapture } from "common-controls.slint";
import { SettingsView, DiscoveredServerItem, HomeCategoryOption, LibraryOptionData } from "SettingsView.slint";
export { DiscoveredServerItem, HomeCategoryOption, LibraryOptionData }
export { VideoCardData, VideoCardRowData }

// Bridge to the theme KeyboardState so Rust code can set ctrl-held: only items
// exported from this file get generated Rust accessors. The alias keeps the
// theme global as the single source of truth for the wheel-zoom handlers.
export global NativeKeyboardState {
    in-out property <bool> ctrl-held <=> KeyboardState.ctrl-held;
}

export struct HomeCategoryShelfData {
    name: string,
    items: [VideoCardData],
    error_message: string,
}

export struct PerformerCardData {
    id: string,
    name: string,
    role: string,
    has_image: bool,
    image: image,
}

export struct DownloadQueueEntry {
    item-id: string,
    title: string,
    status-text: string,
}

export struct DownloadHistoryEntry {
    item-id: string,
    title: string,
    file-path: string,
    size-text: string,
}

// Shared desktop palette. Detailed reusable theme controls live in theme.slint.

// Single responsive grid rule used by the catalog shelves, the performer
// filmography and the studio library so every 16:9 card surface keeps cards
// in the same 220-320px band with identical gaps.
export global HubGrid {
    public pure function gap() -> length {
        return 20px;
    }

    public pure function text-block() -> length {
        return 70px;
    }

    public pure function columns(available: length, min-card: length) -> int {
        // Floor, not round: a rounded-up column count could squeeze cards
        // below their minimum width and force horizontal overflow.
        let n = (available + HubGrid.gap()) / (min-card + HubGrid.gap());
        return Math.max(1, Math.min(8, floor(n)));
    }

    // Session-only Ctrl+wheel card zoom is passed in as `zoom` (1.0 at every
    // launch, never persisted) and only affects the minimum card width, so
    // column counts recompute while gaps and margins stay stable.
    public pure function video-min-card(zoom: float) -> length {
        return 220px * zoom;
    }

    public pure function performer-min-card(zoom: float) -> length {
        return 150px * zoom;
    }

    public pure function card-width(available: length, cols: int) -> length {
        return (available - HubGrid.gap() * (cols - 1)) / cols;
    }

    // Full grid row footprint: 16:9 artwork + text block + row gap.
    public pure function row-height(available: length, cols: int) -> length {
        return HubGrid.card-width(available, cols) * 0.5625 + HubGrid.text-block() + HubGrid.gap();
    }
}

component TvNavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> compact: false;
    in property <bool> active: false;
    in property <bool> has-chevron: false;
    in property <bool> expanded: false;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();
    callback chevron-clicked();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    height: 44px;
    border-radius: HubTheme.control-radius;
    background: root.active ? HubTheme.surface-raised : (root.has-focus || touch.has-hover ? HubTheme.surface-hover : transparent);
    border-width: root.has-focus ? 1px : 0px;
    border-color: root.has-focus ? HubTheme.focus-ring : transparent;

    animate background { duration: 120ms; }

    if root.active && !root.compact : Rectangle {
        x: 0px;
        y: 11px;
        width: 3px;
        height: 22px;
        border-radius: 2px;
        background: HubTheme.accent;
    }

    Rectangle {
        x: root.compact ? (parent.width - self.width) / 2 : 12px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        background: transparent;

        Image {
            source: root.icon;
            width: 20px;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
        }
    }

    if !root.compact : Text {
        x: 48px;
        y: 0px;
        width: root.has-chevron ? parent.width - 86px : parent.width - 60px;
        height: parent.height;
        text: root.text;
        color: root.active || root.has-focus ? HubTheme.text-primary : (touch.has-hover ? HubTheme.text-primary : HubTheme.text-secondary);
        font-size: 14px;
        font-weight: root.active ? 600 : 500;
        vertical-alignment: center;
        overflow: elide;
    }

    if !root.compact && root.has-chevron : Rectangle {
        x: parent.width - 34px;
        y: (parent.height - 24px) / 2;
        width: 24px;
        height: 24px;
        border-radius: 4px;
        background: chevron-touch.has-hover ? #FFFFFF1A : transparent;

        Image {
            source: root.expanded ? @image-url("../../../assets/icons/chevron-down.svg") : @image-url("../../../assets/icons/chevron-right.svg");
            width: 14px;
            height: 14px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
            opacity: 0.7;
        }

        chevron-touch := TouchArea {
            clicked => { root.chevron-clicked(); }
        }
    }

    accessible-description: root.compact ? root.text : "";

    touch := TouchArea {
        width: root.has-chevron && !root.compact ? parent.width - 36px : parent.width;
        clicked => { root.clicked(); }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component TvNavSubButton inherits Rectangle {
    in property <string> text;
    in property <bool> compact: false;
    in property <bool> active: false;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    height: 38px;
    border-radius: HubTheme.control-radius;
    background: root.active ? HubTheme.surface-raised : (root.has-focus || touch.has-hover ? HubTheme.surface-hover : transparent);
    border-width: root.has-focus ? 1px : 0px;
    border-color: root.has-focus ? HubTheme.focus-ring : transparent;

    animate background { duration: 120ms; }

    if root.active && !root.compact : Rectangle {
        x: 0px;
        y: 9px;
        width: 3px;
        height: 20px;
        border-radius: 2px;
        background: HubTheme.accent;
    }

    if !root.compact : Text {
        x: 20px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: root.active || root.has-focus ? HubTheme.text-primary : (touch.has-hover ? HubTheme.text-primary : HubTheme.text-secondary);
        font-size: 13px;
        font-weight: root.active ? 600 : 500;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component TvPrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> glass: false;
    in property <length> custom-height: 40px;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();
    callback activity();

    in property <length> custom-width: 0px;

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    preferred-width: root.custom-width > 0px ? root.custom-width : (btn-text-1.preferred-width + 32px);
    width: root.custom-width > 0px ? root.custom-width : self.preferred-width;
    height: max(40px, root.custom-height);
    border-radius: HubTheme.control-radius;
    background: !root.enabled ? HubTheme.surface-hover : (root.glass
        ? (touch.pressed ? #A3154Ecc : (touch.has-hover ? #D11D66dd : #C2185B88))
        : (touch.pressed ? HubTheme.accent-pressed : (touch.has-hover ? HubTheme.accent-hover : HubTheme.accent)));
    border-width: root.has-focus ? 1px : 0px;
    border-color: root.has-focus ? HubTheme.focus-ring : transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        btn-text-1 := Text {
            text: root.text;
            color: root.enabled ? HubTheme.text-primary : HubTheme.text-muted;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (root.glass && event.kind == PointerEventKind.move) { root.activity(); }
        }
        clicked => {
            if (root.glass) { root.activity(); }
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                if (root.glass) { root.activity(); }
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component TvSecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <bool> glass: false;
    in property <length> custom-height: 40px;
    in property <length> custom-width: 0px;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();
    callback activity();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    preferred-width: root.custom-width > 0px ? root.custom-width : (btn-text-2.preferred-width + 28px);
    width: root.custom-width > 0px ? root.custom-width : self.preferred-width;
    height: max(40px, root.custom-height);
    border-radius: HubTheme.control-radius;
    background: !root.enabled ? HubTheme.navigation-background : (root.glass
        ? (root.active ? #C2185B44 : (root.has-focus || touch.has-hover ? #F5F5F51A : #14141488))
        : (root.active ? #C2185B22 : (root.has-focus || touch.has-hover ? HubTheme.surface-hover : HubTheme.surface)));
    border-width: root.has-focus ? 1px : 0px;
    border-color: root.has-focus ? HubTheme.focus-ring : transparent;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        btn-text-2 := Text {
            text: root.text;
            color: !root.enabled ? HubTheme.text-muted : (root.active || touch.has-hover ? HubTheme.text-primary : HubTheme.text-secondary);
            font-size: 13px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (root.glass && event.kind == PointerEventKind.move) { root.activity(); }
        }
        clicked => {
            if (root.glass) { root.activity(); }
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                if (root.glass) { root.activity(); }
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component DarkLineEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text: "";
    in property <string> accessible-name: root.placeholder-text;
    in property <bool> password-field: false;
    in property <bool> enabled: true;
    in property <int> focus-request-id: 0;
    callback edited(string);
    callback accepted(string);

    height: 40px;
    border-radius: HubTheme.control-radius;
    background: root.enabled ? HubTheme.surface : HubTheme.surface-hover;
    border-width: 1px;
    border-color: input.has-focus ? HubTheme.focus-ring : HubTheme.separator;
    clip: true;
    animate border-color { duration: 120ms; }

    changed focus-request-id => {
        if (root.focus-request-id > 0) {
            input.focus();
        }
    }

    input := TextInput {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        enabled: root.enabled;
        text <=> root.text;
        input-type: root.password-field ? InputType.password : InputType.text;
        accessible-label: root.accessible-name;
        color: root.enabled ? HubTheme.text-primary : HubTheme.text-muted;
        selection-background-color: HubTheme.accent;
        selection-foreground-color: HubTheme.text-primary;
        vertical-alignment: center;
        font-size: 15px;
        changed has-focus => { KeyboardState.text-input-focused = input.has-focus; }
        edited => { root.edited(input.text); }
        accepted => { root.accepted(input.text); }
    }

    if root.text == "" && root.placeholder-text != "" : Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder-text;
        color: root.enabled ? HubTheme.text-muted : HubTheme.control-border;
        font-size: 15px;
        vertical-alignment: center;
        overflow: elide;
    }
}

component PersonPlaceholder inherits Rectangle {
    background: transparent;

    Rectangle {
        x: (parent.width - min(parent.width, parent.height)) / 2 + min(parent.width, parent.height) * 0.36;
        y: (parent.height - min(parent.width, parent.height)) / 2 + min(parent.width, parent.height) * 0.20;
        width: min(parent.width, parent.height) * 0.28;
        height: min(parent.width, parent.height) * 0.28;
        border-radius: min(parent.width, parent.height) * 0.14;
        background: #ff9abc;
    }

    Rectangle {
        x: (parent.width - min(parent.width, parent.height)) / 2 + min(parent.width, parent.height) * 0.20;
        y: (parent.height - min(parent.width, parent.height)) / 2 + min(parent.width, parent.height) * 0.54;
        width: min(parent.width, parent.height) * 0.60;
        height: min(parent.width, parent.height) * 0.30;
        border-radius: min(parent.width, parent.height) * 0.15;
        background: #ff9abc;
    }
}

component ActorChip inherits Rectangle {
    in property <string> name;
    in property <string> role;
    in property <bool> has-image;
    in property <image> image;
    callback clicked();

    width: 176px;
    height: 50px;
    border-radius: 8px;
    background: chip-touch.has-hover ? #2a2232 : #181822;
    border-width: 1px;
    border-color: chip-touch.has-hover ? HubTheme.accent-outline : #FFFFFF18;
    clip: true;
    accessible-role: button;
    accessible-label: root.name;

    chip-touch := TouchArea {
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding: 6px;
        spacing: 8px;
        alignment: start;

        // Avatar (38px x 38px circle)
        Rectangle {
            width: 38px;
            height: 38px;
            border-radius: 19px;
            background: #2b1f30;
            border-width: 1px;
            border-color: #BE185D55;
            clip: true;

            if root.has-image : Image {
                source: root.image;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }
            if !root.has-image : PersonPlaceholder {
                width: 100%;
                height: 100%;
            }
        }

        // Details (Name max 2 lines, role if not empty and != "Performer")
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.name;
                color: chip-touch.has-hover ? HubTheme.text-primary : #e8e3eb;
                font-size: 12px;
                font-weight: 700;
                wrap: word-wrap;
                overflow: elide;
                max-height: 32px;
                horizontal-alignment: left;
            }

            if root.role != "" && root.role != "Performer" && root.role != "Actor" : Text {
                text: root.role;
                color: HubTheme.text-muted;
                font-size: 10px;
                overflow: elide;
                horizontal-alignment: left;
            }
        }
    }
}

component PerformerHeroHeaderDesktop inherits Rectangle {
    in property <string> name;
    in property <string> nationality;
    in property <string> birth;
    in property <string> aliases;
    in property <string> bio;
    in-out property <bool> bio-expanded;
    in property <bool> has-long-bio: false;
    in property <bool> loading: false;
    in property <bool> has-image;
    in property <image> image;

    border-radius: 12px;
    background: HubTheme.surface;
    border-width: 1px;
    border-color: #BE185D33;
    height: hero-layout.preferred-height;
    preferred-height: hero-layout.preferred-height;

    hero-layout := HorizontalLayout {
        padding: 22px;
        spacing: 24px;
        alignment: start;

        // Photo: 4:5 vertical portrait, 176px wide x 220px high. Cover-crop
        // keeps the original aspect ratio and pins the top of the frame so
        // faces are never cut off when the source is taller than 4:5.
        Rectangle {
            width: 176px;
            height: 220px;
            border-radius: 10px;
            background: #2b1f30;
            border-width: 1px;
            border-color: #FFFFFF22;
            clip: true;

            if root.has-image : Image {
                source: root.image;
                property <float> cover-scale: max(176px / max(self.source.width * 1px, 1px), 220px / max(self.source.height * 1px, 1px));
                width: self.source.width * self.cover-scale * 1px;
                height: self.source.height * self.cover-scale * 1px;
                x: (176px - self.width) / 2;
                y: 0px;
            }

            if !root.has-image : PersonPlaceholder {
                width: 100%;
                height: 100%;
            }
        }

        info-col := VerticalLayout {
            horizontal-stretch: 1;
            spacing: 12px;

            Text {
                text: root.name;
                font-size: 26px;
                font-weight: 800;
                color: HubTheme.text-primary;
                wrap: word-wrap;
            }

            if root.nationality != "" || root.birth != "" || root.aliases != "" : HorizontalLayout {
                spacing: 16px;
                alignment: start;
                if root.nationality != "" : Text {
                    text: "Nationality: " + root.nationality;
                    font-size: 13px;
                    color: #ff99bb;
                    font-weight: 600;
                }
                if root.birth != "" : Text {
                    text: "Born: " + root.birth;
                    font-size: 13px;
                    color: HubTheme.text-secondary;
                }
                if root.aliases != "" : Text {
                    text: "AKA: " + root.aliases;
                    font-size: 13px;
                    color: HubTheme.text-muted;
                }
            }

            // Bio: the layout solver wraps the text at the real column width
            // (capped at ~600px ≈ 65-80 characters per line) and clamps it to
            // five lines while collapsed. No height binding is taken from
            // `preferred-height` — that measurement path collapses wrapped
            // text to a single line and caused the 0.2.4 biography regression.
            if root.bio != "" : VerticalLayout {
                spacing: 8px;

                bio-text := Text {
                    text: root.bio;
                    font-size: 15px;
                    color: #d6d2db;
                    wrap: word-wrap;
                    overflow: elide;
                    max-lines: root.bio-expanded ? 0 : 5;
                    max-width: 600px;
                }

                if root.bio-expanded || root.has-long-bio : HorizontalLayout {
                    alignment: start;
                    TvSecondaryButton {
                        text: root.bio-expanded ? "Show less ↑" : "Show more ↓";
                        custom-height: 30px;
                        clicked => { root.bio-expanded = !root.bio-expanded; }
                    }
                }
            }

            if root.bio == "" : Text {
                text: root.loading ? "Loading biography…" : "No biography available.";
                font-size: 14px;
                color: HubTheme.text-muted;
            }

            // Absorb leftover height so name, bio and actions stay top-aligned
            // without distributing free space between the content rows.
            Rectangle {
                background: transparent;
                vertical-stretch: 1;
            }
        }
    }
}

component PerformerHeroHeaderCompact inherits Rectangle {
    in property <string> name;
    in property <string> nationality;
    in property <string> birth;
    in property <string> aliases;
    in property <string> bio;
    in-out property <bool> bio-expanded;

    min-height: 520px;
    background: HubTheme.app-background;
    default-font-family: "Segoe UI Variable";
    forward-focus: keys;

    // View state: "browse", "player", "settings" / "login"
    in-out property <string> active-screen: "home";
    in-out property <string> settings-section: "connection";

    // Player state
    in-out property <image> video-image;

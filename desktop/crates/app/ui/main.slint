    in-out property <string> search-results-filter: "all";
    in-out property <int> search-movie-count: 0;
    in-out property <int> search-performer-count: 0;
    in-out property <int> search-studio-count: 0;
    in-out property <int> search-tag-count: 0;
    in-out property <int> search-channel-count: 0;
    in-out property <string> active-category: "Latest";
    in-out property <string> current-library: "All Videos";
    in-out property <[LibraryOptionData]> library-options: [];
    in-out property <string> catalog-sort-label: "Date added";
    in-out property <string> catalog-duration-label: "Any length";
    in-out property <bool> catalog-sort-descending: true;
    in-out property <bool> catalog-unwatched-only: false;
    in-out property <bool> catalog-favorites-only: false;
    in-out property <bool> catalog-hd-only: false;
    in-out property <bool> catalog-surprise-loading: false;
    in-out property <bool> catalog-category-drilldown: false;
    in-out property <bool> catalog-filter-picker-visible: false;
    in-out property <bool> catalog-filter-options-loading: false;
    in-out property <string> catalog-filter-picker-kind: "genre";
    in-out property <string> catalog-filter-options-query: "";
    in-out property <string> catalog-filter-options-message: "";
    in-out property <[HomeCategoryOption]> catalog-filter-options: [];
    in-out property <string> catalog-genre-query: "";
    in-out property <string> catalog-studio-query: "";
    in-out property <string> catalog-performer-query: "";
    in-out property <int> catalog-active-filter-count: 0;
    in-out property <bool> catalog-filters-expanded: false;
    in-out property <bool> browse-more-expanded: false;
    in-out property <[string]> recent-searches: [];
    in-out property <string> performer-letter: "";
    in-out property <string> performer-search-query: "";
    in-out property <bool> performers-photo-only: false;
    in-out property <bool> performer-filters-expanded: false;
    in-out property <bool> performer-bio-expanded: false;
    // True when the current biography is long enough to be clamped by the

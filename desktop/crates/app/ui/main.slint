}

// Shared desktop palette. Detailed reusable theme controls live in theme.slint.

component TvNavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> compact: false;
    in property <bool> active: false;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    height: 44px;
    border-radius: HubTheme.control-radius;
    background: root.active ? HubTheme.surface-raised : (root.has-focus || touch.has-hover ? HubTheme.surface-hover : transparent);
    border-width: root.has-focus ? 1px : 0px;
    border-color: root.has-focus ? HubTheme.focus-ring : transparent;

    animate background { duration: 120ms; }

    if root.active && !root.compact : Rectangle {
        x: 0px;
        y: 11px;
        width: 3px;
        height: 22px;
        border-radius: 2px;
        background: HubTheme.accent;
    }

    Rectangle {
        x: root.compact ? (parent.width - self.width) / 2 : 12px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        background: transparent;

        Image {
            source: root.icon;
            width: 20px;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
        }
    }

    if !root.compact : Text {
        x: 48px;
        y: 0px;
        width: parent.width - 60px;
        height: parent.height;
        text: root.text;
        color: root.active || root.has-focus ? HubTheme.text-primary : (touch.has-hover ? HubTheme.text-primary : HubTheme.text-secondary);
        font-size: 14px;
        font-weight: root.active ? 600 : 500;
        vertical-alignment: center;
        overflow: elide;
    }

    accessible-description: root.compact ? root.text : "";

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component TvPrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> glass: false;
    in property <length> custom-height: 40px;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();
    callback activity();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    height: max(40px, root.custom-height);
    border-radius: HubTheme.control-radius;
    background: !root.enabled ? HubTheme.surface-hover : (root.glass
        ? (touch.pressed ? #A3154Ecc : (touch.has-hover ? #D11D66dd : #C2185B88))
        : (touch.pressed ? HubTheme.accent-pressed : (touch.has-hover ? HubTheme.accent-hover : HubTheme.accent)));
    border-width: root.has-focus ? 1px : 0px;
    border-color: root.has-focus ? HubTheme.focus-ring : transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        Text {
            text: root.text;
            color: root.enabled ? HubTheme.text-primary : HubTheme.text-muted;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (root.glass && event.kind == PointerEventKind.move) { root.activity(); }
        }
        clicked => {
            if (root.glass) { root.activity(); }
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                if (root.glass) { root.activity(); }
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component TvSecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <bool> glass: false;
    in property <length> custom-height: 40px;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();
    callback activity();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    height: max(40px, root.custom-height);
    border-radius: HubTheme.control-radius;
    background: !root.enabled ? HubTheme.navigation-background : (root.glass
        ? (root.active ? #C2185B44 : (root.has-focus || touch.has-hover ? #F5F5F51A : #14141488))
        : (root.active ? #C2185B22 : (root.has-focus || touch.has-hover ? HubTheme.surface-hover : HubTheme.surface)));
    border-width: root.has-focus ? 1px : 0px;
    border-color: root.has-focus ? HubTheme.focus-ring : transparent;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: !root.enabled ? HubTheme.text-muted : (root.active || touch.has-hover ? HubTheme.text-primary : HubTheme.text-secondary);
            font-size: 13px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (root.glass && event.kind == PointerEventKind.move) { root.activity(); }
        }
        clicked => {
            if (root.glass) { root.activity(); }
            root.clicked();
        }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                if (root.glass) { root.activity(); }
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component DarkLineEdit inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text: "";
    in property <string> accessible-name: root.placeholder-text;
    in property <bool> password-field: false;
    in property <bool> enabled: true;
    in property <int> focus-request-id: 0;
    callback edited(string);
    callback accepted(string);

    height: 40px;
    border-radius: HubTheme.control-radius;
    background: root.enabled ? HubTheme.surface : HubTheme.surface-hover;
    border-width: 1px;
    border-color: input.has-focus ? HubTheme.focus-ring : HubTheme.separator;
    clip: true;
    animate border-color { duration: 120ms; }

    changed focus-request-id => {
        if (root.focus-request-id > 0) {
            input.focus();
        }
    }

    input := TextInput {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        enabled: root.enabled;
        text <=> root.text;
        input-type: root.password-field ? InputType.password : InputType.text;
        accessible-label: root.accessible-name;
        color: root.enabled ? HubTheme.text-primary : HubTheme.text-muted;
        selection-background-color: HubTheme.accent;
        selection-foreground-color: HubTheme.text-primary;
        vertical-alignment: center;
        font-size: 15px;
        changed has-focus => { KeyboardState.text-input-focused = input.has-focus; }
        edited => { root.edited(input.text); }
        accepted => { root.accepted(input.text); }
    }

    if root.text == "" && root.placeholder-text != "" : Text {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder-text;
        color: root.enabled ? HubTheme.text-muted : HubTheme.control-border;
        font-size: 15px;
        vertical-alignment: center;
        overflow: elide;
    }
}

component PersonPlaceholder inherits Rectangle {
    background: transparent;

    Rectangle {
        x: (parent.width - min(parent.width, parent.height)) / 2 + min(parent.width, parent.height) * 0.36;
        y: (parent.height - min(parent.width, parent.height)) / 2 + min(parent.width, parent.height) * 0.20;
        width: min(parent.width, parent.height) * 0.28;
        height: min(parent.width, parent.height) * 0.28;
        border-radius: min(parent.width, parent.height) * 0.14;
        background: #ff9abc;
    }

    Rectangle {
        x: (parent.width - min(parent.width, parent.height)) / 2 + min(parent.width, parent.height) * 0.20;
        y: (parent.height - min(parent.width, parent.height)) / 2 + min(parent.width, parent.height) * 0.54;
        width: min(parent.width, parent.height) * 0.60;
        height: min(parent.width, parent.height) * 0.30;
        border-radius: min(parent.width, parent.height) * 0.15;
        background: #ff9abc;
    }
}

component TvChoiceChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    height: 40px;
    border-radius: HubTheme.control-radius;
    background: root.selected ? HubTheme.surface-raised : (root.has-focus || touch.has-hover ? HubTheme.surface-hover : transparent);
    border-width: root.has-focus ? 1px : 0px;
    border-color: root.has-focus ? HubTheme.focus-ring : transparent;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        Text {
            text: root.text;
            color: root.selected || root.has-focus ? HubTheme.text-primary : (touch.has-hover ? HubTheme.text-primary : HubTheme.text-secondary);
            font-size: 13px;
            font-weight: root.selected ? 700 : 500;
            vertical-alignment: center;
        }
    }

    Rectangle {
        x: 8px;
        y: parent.height - 2px;
        width: parent.width - 16px;
        height: 2px;
        border-radius: 1px;
        background: root.selected ? HubTheme.accent : transparent;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component PerformerLetterChip inherits Rectangle {
    in property <string> letter;
    in property <bool> selected: false;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.letter == "" ? "All performers" : "Performers starting with " + root.letter;
    accessible-action-default => { root.clicked(); }

    width: root.letter == "" ? 38px : 27px;
    height: 28px;
    border-radius: 6px;
    background: root.selected ? HubTheme.accent : (root.has-focus || touch.has-hover ? HubTheme.surface-hover : #17171b);
    border-width: root.has-focus || touch.has-hover ? 1px : 0px;
    border-color: #BE185D88;

    Text {
        text: root.letter == "" ? "ALL" : root.letter;
        color: root.selected || root.has-focus || touch.has-hover ? HubTheme.text-primary : #99959f;
        font-size: 11px;
        font-weight: root.selected ? 700 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component SeekBar inherits Rectangle {
    in property <float> value: 0;
    in property <float> maximum: 1;
    in property <bool> enabled: true;
    callback seek(float);
    callback activity();

    height: 6px;
    border-radius: 3px;
    background: !root.enabled ? #1b1b21 : (touch.has-hover ? #38353f : #2a2931);
    clip: false;

    animate background { duration: 120ms; }

    // Played progress fill (NeonPink)
    Rectangle {
        x: 0;
        y: 0;
        height: 100%;
        width: root.enabled && root.maximum > 0 ? max(0px, min(root.width, root.width * root.value / root.maximum)) : 0px;
        border-radius: 3px;
                        background: root.enabled ? HubTheme.accent : HubTheme.surface-hover;
    }

    // Scrub thumb
    Rectangle {
        x: root.maximum > 0 ? max(0px, min(root.width - 18px, (root.width * root.value / root.maximum) - 9px)) : 0px;
        y: -6px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: HubTheme.text-primary;
        border-width: 4px;
        border-color: HubTheme.accent-outline;
        visible: root.enabled && (touch.has-hover || touch.pressed || root.value > 0);
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.activity();
            root.seek(root.maximum * (self.mouse-x / root.width));
        }
        moved => {
            if (self.pressed) {
                root.activity();
                root.seek(root.maximum * (self.mouse-x / root.width));
            }
        }
    }
}
export component MainWindow inherits Window {
    title: "Adult Hub Desktop";
    icon: @image-url("../../../assets/adult-hub-desktop.svg");
    preferred-width: 1180px;
    preferred-height: 760px;

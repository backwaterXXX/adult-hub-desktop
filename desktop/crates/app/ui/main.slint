import { LineEdit, Slider, ListView, ScrollView } from "std-widgets.slint";

export struct VideoCardData {
    id: string,
    title: string,
    duration: string,
    year: string,
    is_played: bool,
    provider: string,
}

export struct DiscoveredServerItem {
    id: string,
    name: string,
    url: string,
}

// Android TV / Mobile Theme Colors:
// NeonPink: #e91e63
// OledBlack: #08080a
// SurfaceDark: #121212
// CardSurface: #1e1e1e
// CardSurfaceFocused: #2a2a2a
// TextPrimary: #e0e0e0
// TextSecondary: #9e9e9e
// TextMuted: #666666

component TvPrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <length> custom-height: 38px;
    callback clicked();

    height: root.custom-height;
    border-radius: 8px;
    background: !root.enabled ? #2a2a2a : (touch.pressed ? #c2185b : (touch.has-hover ? #ff4081 : #e91e63));
    border-width: touch.has-hover ? 2px : 0px;
    border-color: #ffffff;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        Text {
            text: root.text;
            color: #ffffff;
            font-size: 13px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component TvSecondaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <length> custom-height: 38px;
    callback clicked();

    height: root.custom-height;
    border-radius: 8px;
    background: root.active ? #e91e6333 : (touch.has-hover ? #2a2a2a : #1e1e1e);
    border-width: root.active ? 2px : (touch.has-hover ? 1.5px : 1px);
    border-color: root.active ? #e91e63 : (touch.has-hover ? #e91e6399 : #ffffff1f);

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: root.active ? #ffffff : (touch.has-hover ? #ffffff : #e0e0e0);
            font-size: 13px;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component TvChoiceChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked();

    height: 34px;
    border-radius: 17px;
    background: root.selected ? #e91e63 : (touch.has-hover ? #2a2a2a : #1e1e1e);
    border-width: 1px;
    border-color: root.selected ? #e91e63 : (touch.has-hover ? #e91e6388 : #ffffff1f);

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        alignment: center;
        Text {
            text: root.text;
            color: root.selected ? #ffffff : (touch.has-hover ? #ffffff : #9e9e9e);
            font-size: 13px;
            font-weight: root.selected ? 700 : 500;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component SeekBar inherits Rectangle {
    in property <float> value: 0;
    in property <float> maximum: 1;
    callback seek(float);

    height: 8px;
    border-radius: 4px;
    background: #1e1e28;
    clip: false;

    // Played progress fill (NeonPink)
    Rectangle {
        x: 0;
        y: 0;
        height: 100%;
        width: root.maximum > 0 ? max(0px, min(root.width, root.width * root.value / root.maximum)) : 0px;
        border-radius: 4px;
        background: #e91e63;
    }

    // Scrub thumb
    Rectangle {
        x: root.maximum > 0 ? max(0px, min(root.width - 14px, (root.width * root.value / root.maximum) - 7px)) : 0px;
        y: -4px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #ffffff;
        border-width: 2px;
        border-color: #e91e63;
        visible: touch.has-hover || touch.pressed;
    }

    touch := TouchArea {
        clicked => {
            root.seek(root.maximum * (self.mouse-x / root.width));
        }
        moved => {
            if (self.pressed) {
                root.seek(root.maximum * (self.mouse-x / root.width));
            }
        }
    }
}

component MovieCardItem inherits Rectangle {
    in property <VideoCardData> item;
    callback play();

    height: 104px;
    border-radius: 10px;
    background: touch.has-hover ? #2a2a2a : #1e1e1e;
    border-width: touch.has-hover ? 2px : 1px;
    border-color: touch.has-hover ? #e91e63 : #ffffff1f;
    clip: true;

    HorizontalLayout {
        padding: 8px;
        spacing: 16px;

        // 16:9 Thumbnail preview container
        Rectangle {
            width: 156px;
            height: 88px;
            border-radius: 6px;
            background: #121212;
            clip: true;

            // Subtle gradient background
            Rectangle {
                width: 100%;
                height: 100%;
                background: @linear-gradient(135deg, #24242d 0%, #121212 100%);
            }

            // Center play icon glyph
            Text {
                text: "▶";
                color: touch.has-hover ? #e91e63 : #ffffff55;
                font-size: 26px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Top-left provider badge
            Rectangle {
                x: 6px;
                y: 6px;
                height: 18px;
                border-radius: 4px;
                background: #000000b3;
                border-width: 1px;
                border-color: root.item.provider == "telegram" ? #29b6f6 : (root.item.provider == "local" ? #8bc34a : #e91e63);

                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text {
                        text: root.item.provider == "telegram" ? "TG" : (root.item.provider == "local" ? "LOCAL" : "JF");
                        color: root.item.provider == "telegram" ? #29b6f6 : (root.item.provider == "local" ? #8bc34a : #e91e63);
                        font-size: 9px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                }
            }

            // Top-right WATCHED badge
            if root.item.is_played : Rectangle {
                x: parent.width - self.width - 6px;
                y: 6px;
                height: 18px;
                border-radius: 4px;
                background: #000000c7;
                border-width: 1px;
                border-color: #e91e63;

                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text {
                        text: "WATCHED";
                        color: #e91e63;
                        font-size: 9px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                }
            }

            // Bottom-right Duration badge
            if root.item.duration != "" : Rectangle {
                x: parent.width - self.width - 6px;
                y: parent.height - self.height - 6px;
                height: 18px;
                border-radius: 4px;
                background: #1a1a1acc;

                HorizontalLayout {
                    padding-left: 5px;
                    padding-right: 5px;
                    Text {
                        text: root.item.duration;
                        color: #e0e0e0;
                        font-size: 10px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Details column
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 6px;

            Text {
                text: root.item.title;
                color: touch.has-hover ? #ffffff : #e0e0e0;
                font-size: 15px;
                font-weight: 600;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 8px;

                if root.item.year != "" : Text {
                    text: root.item.year;
                    color: #9e9e9e;
                    font-size: 12px;
                }

                if root.item.year != "" : Text {
                    text: "•";
                    color: #666666;
                    font-size: 12px;
                }

                Text {
                    text: root.item.provider == "telegram" ? "Telegram Video" : (root.item.provider == "local" ? "Local Video" : "Jellyfin Video");
                    color: #9e9e9e;
                    font-size: 12px;
                }
            }
        }

        // Circular play button
        HorizontalLayout {
            alignment: center;
            padding-right: 8px;

            Rectangle {
                width: 44px;
                height: 44px;
                border-radius: 22px;
                background: touch.has-hover ? #e91e63 : #2a2a2a;
                border-width: 1px;
                border-color: touch.has-hover ? #ffffff : #ffffff22;

                Text {
                    text: "▶";
                    color: #ffffff;
                    font-size: 16px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    touch := TouchArea {
        clicked => { root.play(); }
    }
}

export component MainWindow inherits Window {
    title: "Adult Hub Desktop";
    preferred-width: 1180px;
    preferred-height: 760px;
    min-width: 800px;
    min-height: 520px;
    background: #08080a;
    default-font-family: "Segoe UI";
    forward-focus: keys;

    // View state: "browse", "player", "settings" / "login"
    in-out property <string> active-screen: "browse";

    // Player state
    in-out property <image> video-image;
    in-out property <float> position: 0;
    in-out property <float> duration: 0;
    in-out property <bool> playing: false;
    in-out property <bool> hud-visible: false;
    in-out property <bool> muted: false;
    in-out property <string> hud-text: "";
    in-out property <string> status: "Ready";
    in-out property <color> status-color: #9e9e9e;
    in-out property <string> url-text: "";
    in-out property <float> volume: 100;
    in-out property <string> aspect-label: "Aspect: Auto";
    in-out property <string> position-text: "0:00";
    in-out property <string> duration-text: "0:00";
    in-out property <int> texture-width: 640;
    in-out property <int> texture-height: 360;

    // Stage 3 Player Features state
    in-out property <string> speed-label: "1.0x";
    in-out property <string> buffer-profile-label: "Buffer: Standard";
    in-out property <bool> hwdec-active: true;
    in-out property <bool> autoplay-active: false;
    in-out property <bool> resume-prompt-visible: false;
    in-out property <string> resume-prompt-time: "0:00";
    in-out property <float> resume-prompt-position: 0;

    // Browsing & Catalog state
    in-out property <[VideoCardData]> catalog-items: [];
    in-out property <string> search-query: "";
    in-out property <string> active-category: "Latest";
    in-out property <string> current-library: "All Videos";

    // Auth & Settings state
    in-out property <string> server-url-input: "http://localhost:8096";
    in-out property <string> username-input: "";
    in-out property <string> password-input: "";
    in-out property <string> quick-connect-code: "";
    in-out property <string> logged-in-user: "";
    in-out property <bool> is-logged-in: false;

    // Callbacks
    callback switch-screen(string);
    callback toggle-play();
    callback seek-to(float);
    callback seek-relative(float);
    callback set-volume(float);
    callback load-url(string);
    callback open-file();
    callback load-sample();
    callback cycle-aspect();
    callback toggle-hud();
    callback toggle-mute();
    callback toggle-fullscreen();
    callback escape-pressed();

    // Catalog & Auth Callbacks
    callback perform-login(string, string, string);
    callback perform-logout();
    callback start-quick-connect();
    callback cancel-quick-connect();
    callback search-catalog(string);
    callback filter-category(string);
    callback play-item(string);

    // Stage 3 Playback Callbacks
    callback cycle-speed();
    callback cycle-buffer-profile();
    callback toggle-hwdec();
    callback toggle-autoplay();
    callback play-random();
    callback accept-resume();
    callback reject-resume();

    // Stage 4 Desktop & Settings Callbacks
    callback panic-exit();
    callback clear-search-history();
    callback clear-progress-history();

    // Local Server Discovery
    in-out property <[DiscoveredServerItem]> discovered-servers: [];
    in-out property <bool> is-scanning-servers: false;
    callback scan-servers();
    callback select-discovered-server(string);

    VerticalLayout {
        spacing: 0px;

        // Top Navigation Header (matching Android TV HomeTopBar)
        Rectangle {
            height: 64px;
            background: #0d0d12;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                width: 100%;
                background: #ffffff14;
            }

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 16px;
                alignment: center;

                // Logo Brand: ADULT HUB in NeonPink
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    Text {
                        text: "ADULT HUB";
                        color: #e91e63;
                        font-size: 20px;
                        font-weight: 800;
                        letter-spacing: 3px;
                        vertical-alignment: center;
                    }

                    // Library / Platform Badge Pill
                    Rectangle {
                        height: 24px;
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #2a2a2a;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: root.is-logged-in ? root.logged-in-user : "DESKTOP";
                                color: #9e9e9e;
                                font-size: 11px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle { width: 16px; }

                // Navigation Tabs
                TvChoiceChip {
                    text: "Browse";
                    selected: root.active-screen == "browse";
                    clicked => { root.switch-screen("browse"); }
                }

                TvChoiceChip {
                    text: "Player";
                    selected: root.active-screen == "player";
                    clicked => { root.switch-screen("player"); }
                }

                TvChoiceChip {
                    text: root.is-logged-in ? "Settings" : "Connect";
                    selected: root.active-screen == "login" || root.active-screen == "settings";
                    clicked => { root.switch-screen("settings"); }
                }

                Rectangle { horizontal-stretch: 1; }

                // Top Actions (Play Random / Surprise Me, Stats, Mute, Fullscreen)
                TvPrimaryButton {
                    text: "Surprise Me";
                    custom-height: 36px;
                    clicked => { root.play-random(); }
                }

                if root.active-screen == "player" : TvSecondaryButton {
                    text: root.hud-visible ? "Hide Stats" : "Stats";
                    active: root.hud-visible;
                    custom-height: 36px;
                    clicked => { root.toggle-hud(); }
                }

                TvSecondaryButton {
                    text: root.muted ? "Unmute" : "Mute";
                    custom-height: 36px;
                    clicked => { root.toggle-mute(); }
                }

                TvSecondaryButton {
                    text: "Fullscreen";
                    custom-height: 36px;
                    clicked => { root.toggle-fullscreen(); }
                }
            }
        }

        // Main Screen Switcher
        Rectangle {
            vertical-stretch: 1;
            background: #08080a;

            // ==========================================
            // 1. BROWSE SCREEN
            // ==========================================
            if root.active-screen == "browse" : VerticalLayout {
                padding: 20px;
                spacing: 16px;

                // Offline / Guest banner
                if !root.is-logged-in : Rectangle {
                    background: #141418;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #ffffff14;
                    height: 44px;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 12px;
                        alignment: center;

                        Text {
                            text: "🔒 Offline Mode — Connect your Jellyfin server to access your complete adult library.";
                            color: #9e9e9e;
                            font-size: 13px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }

                        TvPrimaryButton {
                            text: "Connect Server";
                            custom-height: 28px;
                            clicked => { root.switch-screen("settings"); }
                        }
                    }
                }

                // Category Filter Chips & Controls Row
                HorizontalLayout {
                    spacing: 10px;
                    height: 36px;

                    TvChoiceChip {
                        text: "Latest";
                        selected: root.active-category == "Latest";
                        clicked => {
                            root.active-category = "Latest";
                            root.filter-category("Latest");
                        }
                    }

                    TvChoiceChip {
                        text: "Resume";
                        selected: root.active-category == "Resume";
                        clicked => {
                            root.active-category = "Resume";
                            root.filter-category("Resume");
                        }
                    }

                    TvChoiceChip {
                        text: "Channels";
                        selected: root.active-category == "Channels";
                        clicked => {
                            root.active-category = "Channels";
                            root.filter-category("Channels");
                        }
                    }

                    TvChoiceChip {
                        text: "Sample";
                        selected: root.active-category == "Sample";
                        clicked => {
                            root.active-category = "Sample";
                            root.load-sample();
                        }
                    }

                    Rectangle { width: 10px; }

                    TvSecondaryButton {
                        text: "Open File...";
                        custom-height: 34px;
                        clicked => { root.open-file(); }
                    }

                    Rectangle { horizontal-stretch: 1; }

                    // Search input
                    LineEdit {
                        width: 280px;
                        text: root.search-query;
                        placeholder-text: "Search videos or channels...";
                        edited(text) => { root.search-query = text; }
                        accepted(text) => {
                            root.search-query = text;
                            root.search-catalog(text);
                        }
                    }

                    TvSecondaryButton {
                        text: "Search";
                        custom-height: 34px;
                        clicked => { root.search-catalog(root.search-query); }
                    }
                }

                // Video Catalog Cards
                ListView {
                    vertical-stretch: 1;

                    for item in root.catalog-items: VerticalLayout {
                        padding-bottom: 10px;
                        MovieCardItem {
                            item: item;
                            play => { root.play-item(item.id); }
                        }
                    }
                }

                // Status & Counter Bar
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Text {
                        text: root.status;
                        color: root.status-color;
                        font-size: 13px;
                        font-weight: 500;
                        horizontal-stretch: 1;
                    }

                    Text {
                        text: root.catalog-items.length + " items";
                        color: #666666;
                        font-size: 12px;
                    }
                }
            }

            // ==========================================
            // 2. PLAYER SCREEN
            // ==========================================
            if root.active-screen == "player" : VerticalLayout {
                spacing: 0px;

                // Video Canvas with OSD Overlays
                Rectangle {
                    vertical-stretch: 1;
                    background: #000000;
                    clip: true;

                    // Embedded mpv OpenGL render target
                    Image {
                        source: root.video-image;
                        image-fit: contain;
                        width: 100%;
                        height: 100%;
                    }

                    // Top OSD Header
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 52px;
                        background: @linear-gradient(180deg, #000000cc 0%, #00000000 100%);

                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            alignment: center;
                            spacing: 14px;

                            TvSecondaryButton {
                                text: "← Browse";
                                custom-height: 32px;
                                clicked => { root.switch-screen("browse"); }
                            }

                            Text {
                                text: root.status;
                                color: #ffffff;
                                font-size: 14px;
                                font-weight: 600;
                                horizontal-stretch: 1;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            // Decoder Mode Badge
                            Rectangle {
                                height: 24px;
                                border-radius: 12px;
                                background: #1e1e1ecc;
                                border-width: 1px;
                                border-color: root.hwdec-active ? #e91e63 : #666666;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    Text {
                                        text: root.hwdec-active ? "HW DECODE" : "SW DECODE";
                                        color: root.hwdec-active ? #e91e63 : #9e9e9e;
                                        font-size: 10px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Floating Stats HUD
                    if root.hud-visible : Rectangle {
                        x: parent.width - self.width - 20px;
                        y: 64px;
                        width: 440px;
                        height: hud-label.preferred-height + 24px;
                        background: #08080af0;
                        border-radius: 8px;
                        border-width: 1.5px;
                        border-color: #e91e63;

                        VerticalLayout {
                            padding: 12px;

                            hud-label := Text {
                                width: 100%;
                                text: root.hud-text;
                                color: #e0e0e0;
                                font-size: 12px;
                                font-family: "Consolas";
                                wrap: word-wrap;
                            }
                        }
                    }

                    // Floating Resume Prompt Banner
                    if root.resume-prompt-visible : Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 24px;
                        width: 480px;
                        height: 58px;
                        background: #08080af5;
                        border-radius: 10px;
                        border-width: 2px;
                        border-color: #e91e63;

                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 14px;
                            alignment: center;

                            Text {
                                text: "Resume from " + root.resume-prompt-time + "?";
                                color: #ffffff;
                                font-size: 15px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            TvPrimaryButton {
                                text: "Resume";
                                custom-height: 36px;
                                clicked => { root.accept-resume(); }
                            }

                            TvSecondaryButton {
                                text: "Restart";
                                custom-height: 36px;
                                clicked => { root.reject-resume(); }
                            }
                        }
                    }
                }

                // Bottom Player Controls Panel
                Rectangle {
                    height: 172px;
                    background: #0e0e14;

                    Rectangle {
                        y: 0px;
                        height: 1px;
                        width: 100%;
                        background: #ffffff14;
                    }

                    VerticalLayout {
                        padding-left: 20px;
                        padding-right: 20px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        spacing: 12px;

                        // Row 1: Time, SeekBar, Duration & Quick Seekers
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: center;

                            Text {
                                text: root.position-text;
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 600;
                                width: 54px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }

                            SeekBar {
                                horizontal-stretch: 1;
                                value: root.position;
                                maximum: max(0.001, root.duration);
                                seek(value) => { root.seek-to(value); }
                            }

                            Text {
                                text: root.duration-text;
                                color: #9e9e9e;
                                font-size: 13px;
                                font-weight: 500;
                                width: 54px;
                                vertical-alignment: center;
                            }

                            TvSecondaryButton {
                                text: "-10s";
                                custom-height: 30px;
                                clicked => { root.seek-relative(-10); }
                            }

                            TvSecondaryButton {
                                text: "+10s";
                                custom-height: 30px;
                                clicked => { root.seek-relative(10); }
                            }
                        }

                        // Row 2: Play/Pause, Speed, Buffer, HW Decode, Autoplay, Random, Aspect & Volume
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;

                            TvPrimaryButton {
                                text: root.playing ? "Pause" : "Play";
                                custom-height: 36px;
                                clicked => { root.toggle-play(); }
                            }

                            TvSecondaryButton {
                                text: "Speed: " + root.speed-label;
                                active: root.speed-label != "1.0x";
                                custom-height: 36px;
                                clicked => { root.cycle-speed(); }
                            }

                            TvSecondaryButton {
                                text: root.buffer-profile-label;
                                custom-height: 36px;
                                clicked => { root.cycle-buffer-profile(); }
                            }

                            TvSecondaryButton {
                                text: root.hwdec-active ? "HW: ON" : "HW: OFF";
                                active: root.hwdec-active;
                                custom-height: 36px;
                                clicked => { root.toggle-hwdec(); }
                            }

                            TvSecondaryButton {
                                text: root.autoplay-active ? "Autoplay: ON" : "Autoplay: OFF";
                                active: root.autoplay-active;
                                custom-height: 36px;
                                clicked => { root.toggle-autoplay(); }
                            }

                            TvSecondaryButton {
                                text: "Random Next";
                                custom-height: 36px;
                                clicked => { root.play-random(); }
                            }

                            TvSecondaryButton {
                                text: root.aspect-label;
                                custom-height: 36px;
                                clicked => { root.cycle-aspect(); }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            Text {
                                text: "Vol";
                                color: #9e9e9e;
                                font-size: 12px;
                                vertical-alignment: center;
                            }

                            Slider {
                                width: 110px;
                                minimum: 0;
                                maximum: 130;
                                value: root.volume;
                                changed(value) => { root.set-volume(value); }
                            }
                        }

                        // Row 3: Direct URL / Path Load Input
                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;

                            LineEdit {
                                horizontal-stretch: 1;
                                text: root.url-text;
                                placeholder-text: "Direct media URL or local video file path...";
                                edited(text) => { root.url-text = text; }
                                accepted(text) => {
                                    root.url-text = text;
                                    root.load-url(text);
                                    keys.focus();
                                }
                            }

                            TvSecondaryButton {
                                text: "Load";
                                custom-height: 34px;
                                clicked => {
                                    root.load-url(root.url-text);
                                    keys.focus();
                                }
                            }
                        }
                    }
                }
            }

            // ==========================================
            // 3. SETTINGS & SERVER SCREEN
            // ==========================================
            if root.active-screen == "login" || root.active-screen == "settings" : ScrollView {
                VerticalLayout {
                    padding: 28px;
                    spacing: 20px;
                    alignment: start;

                    // Header
                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "Settings & Server Connection";
                            color: #e0e0e0;
                            font-size: 22px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: "Adult Hub Desktop v0.1.0";
                            color: #e91e63;
                            font-size: 13px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }

                    // Status notification banner
                    if root.status != "" && root.status != "Ready" : Rectangle {
                        height: 42px;
                        border-radius: 8px;
                        background: #121212;
                        border-width: 1px;
                        border-color: root.status-color;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            Text {
                                text: "✓ " + root.status;
                                color: root.status-color;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Card 1: Server Connection
                    Rectangle {
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #ffffff14;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 16px;

                            Text {
                                text: "Jellyfin Server";
                                color: #e91e63;
                                font-size: 16px;
                                font-weight: 700;
                            }

                            if !root.is-logged-in : VerticalLayout {
                                spacing: 12px;

                                Text {
                                    text: "Server Address (HTTP LAN or HTTPS):";
                                    color: #9e9e9e;
                                    font-size: 13px;
                                }

                                LineEdit {
                                    text: root.server-url-input;
                                    placeholder-text: "http://192.168.1.100:8096 or https://...";
                                    edited(text) => { root.server-url-input = text; }
                                }

                                // Discovered Servers (Android TV style)
                                VerticalLayout {
                                    spacing: 8px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        Text {
                                            text: "Discovered Servers:";
                                            color: #e0e0e0;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }

                                        TvSecondaryButton {
                                            text: root.is-scanning-servers ? "Scanning..." : "Scan LAN";
                                            custom-height: 28px;
                                            clicked => { root.scan-servers(); }
                                        }
                                    }

                                    if root.discovered-servers.length > 0 : HorizontalLayout {
                                        spacing: 8px;
                                        for s in root.discovered-servers : Rectangle {
                                            background: s-touch.has-hover ? #2e2e34 : #1c1c22;
                                            border-radius: 6px;
                                            border-width: 1px;
                                            border-color: s-touch.has-hover ? #e91e63 : #ffffff22;
                                            height: 32px;

                                            s-touch := TouchArea {
                                                clicked => {
                                                    root.server-url-input = s.url;
                                                    root.select-discovered-server(s.url);
                                                }
                                            }

                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 10px;
                                                spacing: 6px;
                                                alignment: center;

                                                Text {
                                                    text: "🖥️ " + s.name;
                                                    color: #ffffff;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }

                                                Text {
                                                    text: "(" + s.url + ")";
                                                    color: #9e9e9e;
                                                    font-size: 11px;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    if root.discovered-servers.length == 0 : Text {
                                        text: root.is-scanning-servers ? "Scanning local network for Jellyfin servers..." : "No local servers discovered. Enter address manually or click Scan LAN.";
                                        color: #757575;
                                        font-size: 12px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 14px;

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Text { text: "Username:"; color: #9e9e9e; font-size: 13px; }
                                        LineEdit {
                                            text: root.username-input;
                                            placeholder-text: "Username";
                                            edited(text) => { root.username-input = text; }
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 6px;
                                        Text { text: "Password:"; color: #9e9e9e; font-size: 13px; }
                                        LineEdit {
                                            text: root.password-input;
                                            placeholder-text: "Password";
                                            input-type: password;
                                            edited(text) => { root.password-input = text; }
                                        }
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 14px;
                                    padding-top: 4px;

                                    TvPrimaryButton {
                                        text: "Sign In";
                                        horizontal-stretch: 1;
                                        clicked => {
                                            root.perform-login(
                                                root.server-url-input,
                                                root.username-input,
                                                root.password-input
                                            );
                                        }
                                    }

                                    TvSecondaryButton {
                                        text: "Quick Connect";
                                        horizontal-stretch: 1;
                                        clicked => { root.start-quick-connect(); }
                                    }
                                }

                                if root.quick-connect-code != "" : Rectangle {
                                    background: #121212;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: #e91e63;
                                    height: 52px;

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 16px;
                                        padding-left: 16px;
                                        padding-right: 16px;

                                        Text {
                                            text: "Authorize code: " + root.quick-connect-code;
                                            color: #e91e63;
                                            font-size: 18px;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }

                                        TvSecondaryButton {
                                            text: "Cancel";
                                            custom-height: 32px;
                                            clicked => { root.cancel-quick-connect(); }
                                        }
                                    }
                                }
                            }

                            if root.is-logged-in : VerticalLayout {
                                spacing: 14px;

                                HorizontalLayout {
                                    alignment: center;
                                    spacing: 16px;

                                    Rectangle {
                                        width: 50px;
                                        height: 50px;
                                        border-radius: 25px;
                                        background: #e91e6333;
                                        border-width: 2px;
                                        border-color: #e91e63;

                                        Text {
                                            text: "👤";
                                            font-size: 22px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 4px;

                                        Text {
                                            text: root.logged-in-user;
                                            color: #ffffff;
                                            font-size: 18px;
                                            font-weight: 700;
                                        }

                                        Text {
                                            text: "Connected to " + root.server-url-input;
                                            color: #9e9e9e;
                                            font-size: 13px;
                                        }
                                    }

                                    TvSecondaryButton {
                                        text: "Log Out";
                                        clicked => { root.perform-logout(); }
                                    }
                                }
                            }
                        }
                    }

                    // Card 2: Playback & Engine Preferences
                    Rectangle {
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #ffffff14;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 16px;

                            Text {
                                text: "Playback & Engine";
                                color: #e91e63;
                                font-size: 16px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                TvSecondaryButton {
                                    text: root.buffer-profile-label;
                                    horizontal-stretch: 1;
                                    clicked => { root.cycle-buffer-profile(); }
                                }

                                TvSecondaryButton {
                                    text: root.hwdec-active ? "Hardware Decode: ON" : "Hardware Decode: OFF";
                                    active: root.hwdec-active;
                                    horizontal-stretch: 1;
                                    clicked => { root.toggle-hwdec(); }
                                }

                                TvSecondaryButton {
                                    text: root.autoplay-active ? "Autoplay: ON" : "Autoplay: OFF";
                                    active: root.autoplay-active;
                                    horizontal-stretch: 1;
                                    clicked => { root.toggle-autoplay(); }
                                }
                            }
                        }
                    }

                    // Card 3: Privacy & Data Management
                    Rectangle {
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #ffffff14;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 16px;

                            Text {
                                text: "Data & Privacy";
                                color: #e91e63;
                                font-size: 16px;
                                font-weight: 700;
                            }

                            HorizontalLayout {
                                spacing: 14px;

                                TvSecondaryButton {
                                    text: "Clear Search History";
                                    horizontal-stretch: 1;
                                    clicked => { root.clear-search-history(); }
                                }

                                TvSecondaryButton {
                                    text: "Clear Watch History & Progress";
                                    horizontal-stretch: 1;
                                    clicked => { root.clear-progress-history(); }
                                }
                            }
                        }
                    }

                    // Card 4: Emergency Panic Exit
                    Rectangle {
                        border-radius: 12px;
                        background: #1e1e1e;
                        border-width: 1px;
                        border-color: #ffffff14;

                        VerticalLayout {
                            padding: 22px;
                            spacing: 12px;

                            Text {
                                text: "Panic Exit (Emergency Hide)";
                                color: #e91e63;
                                font-size: 16px;
                                font-weight: 700;
                            }

                            Text {
                                text: "Press Ctrl+Shift+Q anywhere in the application to immediately hide windows, silence audio, and terminate the process.";
                                color: #9e9e9e;
                                font-size: 13px;
                            }

                            HorizontalLayout {
                                TvPrimaryButton {
                                    text: "Panic Exit Now (Ctrl+Shift+Q)";
                                    clicked => { root.panic-exit(); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    keys := FocusScope {
        key-pressed(event) => {
            // Panic Exit: Ctrl+Shift+Q
            if (event.modifiers.control && event.modifiers.shift && (event.text == "q" || event.text == "Q")) {
                root.panic-exit();
                return accept;
            }

            // Quick navigation
            if (event.text == "1") {
                root.switch-screen("browse");
                return accept;
            }
            if (event.text == "2") {
                root.switch-screen("player");
                return accept;
            }
            if (event.text == "3") {
                root.switch-screen("settings");
                return accept;
            }

            // Player controls
            if (event.text == Key.Space) {
                root.toggle-play();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.seek-relative(-5);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.seek-relative(5);
                return accept;
            }
            if (event.text == "f") {
                root.toggle-fullscreen();
                return accept;
            }
            if (event.text == "i") {
                root.toggle-hud();
                return accept;
            }
            if (event.text == "m") {
                root.toggle-mute();
                return accept;
            }
            if (event.text == "s") {
                root.cycle-speed();
                return accept;
            }
            if (event.text == "b") {
                root.cycle-buffer-profile();
                return accept;
            }
            if (event.text == "h") {
                root.toggle-hwdec();
                return accept;
            }
            if (event.text == "n") {
                root.play-random();
                return accept;
            }
            if (event.text == Key.Escape) {
                root.escape-pressed();
                return accept;
            }
            reject
        }
    }
}

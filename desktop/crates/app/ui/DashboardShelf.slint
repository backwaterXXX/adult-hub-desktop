import { ScrollView } from "std-widgets.slint";
import { VideoCard, VideoCardData } from "VideoCard.slint";
import { HubTheme } from "theme.slint";
import { SectionHeader } from "common-controls.slint";

export component PerformerCard inherits Rectangle {
    in property <VideoCardData> item;
    in property <bool> is-focused: false;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-action-default => { root.clicked(); }

    width: 140px;
    height: 258px;
    border-radius: HubTheme.card-radius;
    background: root.is-focused || root.has-focus || touch.has-hover ? HubTheme.surface-hover : HubTheme.surface;
    border-width: 1px;
    border-color: root.has-focus ? HubTheme.focus-ring : (root.is-focused || touch.has-hover ? HubTheme.control-border : HubTheme.separator);
    clip: true;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 200px;
            background: HubTheme.navigation-background;
            clip: true;

            if root.item.has-thumbnail : Image {
                source: root.item.thumbnail;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }

            if !root.item.has-thumbnail : Rectangle {
                width: 100%;
                height: 100%;
                background: HubTheme.navigation-background;
                Rectangle {
                    x: (parent.width - 34px) / 2;
                    y: 54px;
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    background: HubTheme.surface-hover;
                }
                Rectangle {
                    x: (parent.width - 62px) / 2;
                    y: 98px;
                    width: 62px;
                    height: 42px;
                    border-radius: 22px;
                    background: HubTheme.surface-hover;
                }
            }
        }

        VerticalLayout {
            height: 58px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 1px;
            alignment: start;

            Text {
                text: root.item.title;
                color: HubTheme.text-primary;
                font-size: HubTheme.card-title-size;
                font-weight: 600;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
                width: 100%;
            }

            if root.item.studio != "" : Text {
                text: root.item.studio;
                color: HubTheme.text-muted;
                font-size: HubTheme.metadata-size;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
                width: 100%;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component DashboardSkeletonCard inherits Rectangle {
    width: 250px;
    height: 219px;
    border-radius: HubTheme.card-radius;
    background: HubTheme.surface;
    border-width: 1px;
    border-color: HubTheme.separator;
    clip: true;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 140px;
            background: HubTheme.surface-hover;
        }

        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 12px;
            spacing: 8px;
            Rectangle {
                width: 145px;
                height: 8px;
                border-radius: 3px;
                background: #F3F4F61C;
            }
            Rectangle {
                width: 82px;
                height: 6px;
                border-radius: 3px;
                background: #F3F4F612;
            }
        }
    }
}

export component DashboardShelf inherits VerticalLayout {
    in property <string> title;
    in property <[VideoCardData]> items;
    in property <string> action-label: "See all";
    in property <string> category-name: "";
    in property <bool> performer-cards: false;
    in property <string> empty-message: "";
    in property <bool> loading: false;
    in property <string> error-message: "";

    callback play-item(string);
    callback open-item(string);
    callback thumbnail-retry(VideoCardData);
    callback open-performer(string);
    callback show-all(string);
    callback retry();


        if root.items.length > 0 || root.empty-message != "" || root.loading || root.error-message != "" : VerticalLayout {
        spacing: HubTheme.space-4;

        SectionHeader {
            title: root.title;
            action-label: root.action-label;
            show-scroll-controls: !root.performer-cards && root.items.length > 2;
            scroll-left-disabled: shelf-scroll.content-x >= 0px;
            scroll-right-disabled: shelf-scroll.content-x <= min(0px, root.width - max(root.width, root.items.length * 266px - 16px));
            action => { root.show-all(root.category-name); }
            scroll-left => {
                shelf-scroll.content-x = min(0px, shelf-scroll.content-x + 266px);
            }
            scroll-right => {
                shelf-scroll.content-x = max(min(0px, root.width - max(root.width, root.items.length * 266px - 16px)), shelf-scroll.content-x - 266px);
            }
        }

        if root.error-message != "" : Rectangle {
            height: 54px;
            border-radius: 9px;
            background: #21151a;
            border-width: 1px;
                border-color: #FB718555;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 10px;
                alignment: center;
                Text {
                    text: "!";
                    width: 20px;
                    color: HubTheme.error;
                    font-size: 15px;
                    font-weight: 800;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Text {
                    text: root.error-message;
                    color: HubTheme.text-secondary;
                    font-size: HubTheme.metadata-size;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: retry-touch.has-hover ? #34202a : #281a21;
                    border-width: 1px;
                border-color: #FB718570;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: "Retry";
                            color: HubTheme.text-primary;
                            font-size: HubTheme.metadata-size;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                        accessible-role: button;
                        accessible-label: "Retry " + root.title;
                        accessible-action-default => { root.retry(); }
                    retry-touch := TouchArea {
                        clicked => { root.retry(); }
                    }
                }
            }
        }

        shelf-scroll := ScrollView {
            height: root.items.length == 0 ? 0px : (root.performer-cards ? 284px : 240px);
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
            mouse-drag-pan-enabled: true;

            if root.performer-cards && root.items.length > 0 : HorizontalLayout {
                width: max(root.width, root.items.length * 156px - 16px);
                height: 270px;
                spacing: HubTheme.space-4;

                for card in root.items : PerformerCard {
                    item: card;
                    clicked => { root.open-performer(card.title); }
                }
            }

            if !root.performer-cards && root.items.length > 0 : HorizontalLayout {
                width: max(root.width, root.items.length * 266px - 16px);
                height: 224px;
                spacing: HubTheme.space-4;

                for card in root.items : VideoCard {
                    item: card;
                    card-width: 250px;
                    fixed-width: true;
                    play => { root.play-item(card.id); }
                    open-detail => { root.open-item(card.id); }
                    thumbnail-retry(item) => { root.thumbnail-retry(item); }
                }
            }
        }

        if root.items.length == 0 && root.loading : ScrollView {
                height: 240px;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                horizontal-scrollbar-policy: ScrollBarPolicy.always-off;

                HorizontalLayout {
                    width: max(root.width, 4 * 266px - 16px);
                    height: 224px;
                    spacing: HubTheme.space-4;

                    DashboardSkeletonCard {}
                    DashboardSkeletonCard {}
                    DashboardSkeletonCard {}
                    DashboardSkeletonCard {}
                }
        }

        if root.items.length == 0 && !root.loading && root.error-message == "" && root.empty-message != "" : Rectangle {
            height: 54px;
            border-radius: 8px;
            background: HubTheme.surface;
            border-width: 1px;
            border-color: HubTheme.separator;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                alignment: center;

                Text {
                    text: root.empty-message;
                    color: HubTheme.text-secondary;
                    font-size: HubTheme.metadata-size;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}

import { ScrollView } from "std-widgets.slint";
import { VideoCard, VideoCardData } from "VideoCard.slint";
import { HubTheme } from "theme.slint";
import { SectionHeader } from "common-controls.slint";

export component PerformerCard inherits Rectangle {
    in property <VideoCardData> item;
    in property <bool> is-focused: false;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-action-default => { root.clicked(); }

    width: 140px;
    height: 258px;
    border-radius: HubTheme.card-radius;
    background: root.is-focused || root.has-focus || touch.has-hover ? HubTheme.surface-hover : HubTheme.surface;
    border-width: 1px;
    border-color: root.has-focus ? HubTheme.focus-ring : (root.is-focused || touch.has-hover ? HubTheme.control-border : HubTheme.separator);
    clip: true;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 200px;
            background: HubTheme.navigation-background;
            clip: true;

            if root.item.has-thumbnail : Image {
                source: root.item.thumbnail;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }

            if !root.item.has-thumbnail : Rectangle {
                width: 100%;
                height: 100%;
                background: HubTheme.navigation-background;
                Rectangle {
                    x: (parent.width - 34px) / 2;
                    y: 54px;
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    background: HubTheme.surface-hover;
                }
                Rectangle {
                    x: (parent.width - 62px) / 2;
                    y: 98px;
                    width: 62px;
                    height: 42px;
                    border-radius: 22px;
                    background: HubTheme.surface-hover;
                }
            }
        }

        VerticalLayout {
            height: 58px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 1px;
            alignment: start;

            Text {
                text: root.item.title;
                color: HubTheme.text-primary;
                font-size: HubTheme.card-title-size;
                font-weight: 600;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
                width: 100%;
            }

            if root.item.studio != "" : Text {
                text: root.item.studio;
                color: HubTheme.text-muted;
                font-size: HubTheme.metadata-size;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
                width: 100%;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component DashboardSkeletonCard inherits Rectangle {
    property <length> artwork-height: min(220px, root.width * 0.5625);
    preferred-width: 240px;
    min-width: 160px;
    horizontal-stretch: 1;
    height: root.artwork-height + 82px;
    border-radius: HubTheme.card-radius;
    background: HubTheme.surface;
    border-width: 1px;
    border-color: HubTheme.separator;
    clip: true;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: root.artwork-height;
            background: HubTheme.surface-hover;
        }

        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            height: 82px;
            padding-top: 12px;
            spacing: 8px;
            Rectangle {
                width: 145px;
                height: 8px;
                border-radius: 3px;
                background: #F3F4F61C;
            }
            Rectangle {
                width: 82px;
                height: 6px;
                border-radius: 3px;
                background: #F3F4F612;
            }
        }
    }
}

export component DashboardShelf inherits VerticalLayout {
    in property <string> title;
    in property <[VideoCardData]> items;
    in property <string> action-label: "See all";
    in property <string> category-name: "";
    in property <bool> performer-cards: false;
    in property <string> empty-message: "";
    in property <bool> loading: false;
    in property <string> error-message: "";

    callback play-item(string);
    callback open-item(string);
    callback thumbnail-retry(VideoCardData);
    callback open-performer(string);
    callback show-all(string);
    callback retry();


        if root.items.length > 0 || root.empty-message != "" || root.loading || root.error-message != "" : VerticalLayout {
        spacing: HubTheme.space-4;

        SectionHeader {
            title: root.title;
            action-label: root.action-label;
            show-scroll-controls: false;
            action => { root.show-all(root.category-name); }
        }

        if root.error-message != "" : Rectangle {
            height: 54px;
            border-radius: 9px;
            background: HubTheme.surface;
            border-width: 0px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 10px;
                alignment: center;
                Image {
                    source: @image-url("../../../assets/icons/alert.svg");
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                }
                Text {
                    text: root.error-message;
                    color: HubTheme.text-secondary;
                    font-size: HubTheme.metadata-size;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: retry-touch.has-hover ? HubTheme.surface-hover : transparent;
                    border-width: 0px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: "Retry";
                            color: HubTheme.text-primary;
                            font-size: HubTheme.metadata-size;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                        accessible-role: button;
                        accessible-label: "Retry " + root.title;
                        accessible-action-default => { root.retry(); }
                    retry-touch := TouchArea {
                        clicked => { root.retry(); }
                    }
                }
            }
        }

        if root.items.length > 0 && root.performer-cards : HorizontalLayout {
            height: 270px;
            spacing: HubTheme.space-4;
            if root.items.length > 0 : PerformerCard {
                horizontal-stretch: 1;
                item: root.items[0];
                clicked => { root.open-performer(root.items[0].title); }
            }
            if root.items.length > 1 : PerformerCard {
                horizontal-stretch: 1;
                item: root.items[1];
                clicked => { root.open-performer(root.items[1].title); }
            }
            if root.items.length > 2 : PerformerCard {
                horizontal-stretch: 1;
                item: root.items[2];
                clicked => { root.open-performer(root.items[2].title); }
            }
        }

        if root.items.length > 0 && !root.performer-cards : HorizontalLayout {
            height: root.items.length == 1
                ? min(302px, min(220px, min(root.width, 560px) * 0.5625) + 82px)
                : (root.items.length == 2
                    ? min(302px, min(220px, ((root.width - 16px) / 2) * 0.5625) + 82px)
                    : min(302px, max(206px, min(220px, ((root.width - 32px) / 3) * 0.5625) + 82px)));
            spacing: HubTheme.space-4;
            if root.items.length > 0 : VideoCard {
                item: root.items[0];
                card-width: 240px;
                max-width: 560px;
                fixed-width: false;
                play => { root.play-item(root.items[0].id); }
                open-detail => { root.open-item(root.items[0].id); }
                thumbnail-retry(item) => { root.thumbnail-retry(item); }
            }
            if root.items.length > 1 : VideoCard {
                item: root.items[1];
                card-width: 240px;
                max-width: 560px;
                fixed-width: false;
                play => { root.play-item(root.items[1].id); }
                open-detail => { root.open-item(root.items[1].id); }
                thumbnail-retry(item) => { root.thumbnail-retry(item); }
            }
            if root.items.length > 2 : VideoCard {
                item: root.items[2];
                card-width: 240px;
                max-width: 560px;
                fixed-width: false;
                play => { root.play-item(root.items[2].id); }
                open-detail => { root.open-item(root.items[2].id); }
                thumbnail-retry(item) => { root.thumbnail-retry(item); }
            }
        }

        if root.items.length == 0 && root.loading : HorizontalLayout {
            height: min(302px, max(206px, min(220px, ((root.width - 32px) / 3) * 0.5625) + 82px));
            spacing: HubTheme.space-4;
            DashboardSkeletonCard { horizontal-stretch: 1; }
            DashboardSkeletonCard { horizontal-stretch: 1; }
            DashboardSkeletonCard { horizontal-stretch: 1; }
        }

        if root.items.length == 0 && !root.loading && root.error-message == "" && root.empty-message != "" : Rectangle {
            height: 54px;
            border-radius: 8px;
            background: HubTheme.surface;
            border-width: 1px;
            border-color: HubTheme.separator;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                alignment: center;

                Text {
                    text: root.empty-message;
                    color: HubTheme.text-secondary;
                    font-size: HubTheme.metadata-size;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}

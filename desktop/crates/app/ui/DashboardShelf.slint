import { ScrollView } from "std-widgets.slint";
import { VideoCard, VideoCardData } from "VideoCard.slint";
import { HubTheme } from "theme.slint";
import { SectionHeader } from "common-controls.slint";

// Shared responsive grid for video collections in performer and studio
// profiles. The caller selects the same HubGrid card width used by catalog
// rows; this component handles wrapping, spacing, and card actions uniformly.
export component VideoCardGrid inherits FlexboxLayout {
    in property <[VideoCardData]> items: [];
    in property <length> grid-width: 0px;
    in property <length> card-width: 220px;
    in property <length> gap: 20px;
    callback play(string);
    callback open-detail(string);

    width: root.grid-width;
    // Every row starts at the first column. Keep unused space after the last
    // card instead of redistributing it across a partial row.
    alignment: start;
    spacing-horizontal: root.gap;
    spacing-vertical: root.gap;

    for item in root.items : VideoCard {
        item: item;
        card-width: root.card-width;
        fixed-width: true;
        play => { root.play(item.id); }
        open-detail => { root.open-detail(item.id); }
    }
}

export component PerformerCard inherits Rectangle {
    in property <VideoCardData> item;
    in property <bool> is-focused: false;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-action-default => { root.clicked(); }

    in property <length> card-width: 160px;
    in property <bool> fixed-width: true;

    preferred-width: root.fixed-width ? root.card-width : 170px;
    min-width: root.fixed-width ? 150px : 0px;
    max-width: 190px;
    height: 260px;
    border-radius: HubTheme.card-radius;
    background: touch.has-hover ? HubTheme.surface-hover : ((root.is-focused || root.has-focus) ? #FFFFFF08 : HubTheme.surface);
    border-width: (root.is-focused || root.has-focus) ? 2px : (touch.has-hover ? 1px : 0px);
    border-color: (root.is-focused || root.has-focus) ? HubTheme.focus-ring : HubTheme.separator;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            vertical-stretch: 1;
            background: HubTheme.navigation-background;
            clip: true;

            // Performer portraits put the face in the top of the frame, so the
            // cover crop is pinned to the top edge instead of centred; a
            // centred crop cut heads off on source images taller than the card.
            if root.item.has-thumbnail : Image {
                source: root.item.thumbnail;
                property <float> cover-scale: max(parent.width / max(self.source.width * 1px, 1px), parent.height / max(self.source.height * 1px, 1px));
                width: self.source.width * self.cover-scale * 1px;
                height: self.source.height * self.cover-scale * 1px;
                x: (parent.width - self.width) / 2;
                y: 0px;
            }

            if !root.item.has-thumbnail : Rectangle {
                width: 100%;
                height: 100%;
                background: HubTheme.surface-raised;
                Image {
                    source: @image-url("../../../assets/icons/person.svg");
                    width: 48px;
                    height: 48px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                    opacity: 0.35;
                }
            }
        }

        VerticalLayout {
            height: 58px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 1px;
            alignment: start;

            Text {
                text: root.item.title;
                color: HubTheme.text-primary;
                font-size: HubTheme.card-title-size;
                font-weight: 600;
                horizontal-alignment: left;
                vertical-alignment: center;
                wrap: word-wrap;
                max-height: 38px;
                overflow: elide;
                width: 100%;
            }

            if root.item.studio != "" : Text {
                text: root.item.studio;
                color: HubTheme.text-muted;
                font-size: HubTheme.metadata-size;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
                width: 100%;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

export component StudioCard inherits Rectangle {
    in property <VideoCardData> item;
    in property <bool> is-focused: false;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-action-default => { root.clicked(); }

    in property <length> card-width: 240px;
    width: root.card-width;
    preferred-width: root.card-width;
    height: 72px;
    border-radius: HubTheme.card-radius;
    background: touch.has-hover ? HubTheme.surface-hover : ((root.is-focused || root.has-focus) ? #FFFFFF08 : HubTheme.surface);
    border-width: (root.is-focused || root.has-focus) ? 2px : (touch.has-hover ? 1px : 0px);
    border-color: (root.is-focused || root.has-focus) ? HubTheme.focus-ring : HubTheme.separator;
    clip: true;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 12px;
        alignment: start;

        Rectangle {
            width: 38px;
            height: 38px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: HubTheme.surface-raised;
            clip: true;

            if root.item.has-thumbnail : Image {
                source: root.item.thumbnail;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }

            if !root.item.has-thumbnail : Image {
                source: @image-url("../../../assets/icons/building.svg");
                width: 18px;
                height: 18px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
                opacity: 0.45;
            }
        }

        Text {
            text: root.item.title;
            horizontal-stretch: 1;
            color: HubTheme.text-primary;
            font-size: HubTheme.card-title-size;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            max-lines: 2;
            wrap: word-wrap;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

export component CategoryCard inherits Rectangle {
    in property <VideoCardData> item;
    in property <bool> is-focused: false;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();

    forward-focus: focus-scope;
    accessible-role: button;
    accessible-label: root.item.title;
    accessible-action-default => { root.clicked(); }

    in property <length> card-width: 240px;
    property <length> artwork-height: min(120px, root.card-width * 0.45);

    width: root.card-width;
    preferred-width: root.card-width;
    height: root.artwork-height + 56px;
    border-radius: HubTheme.card-radius;
    background: touch.has-hover ? HubTheme.surface-hover : ((root.is-focused || root.has-focus) ? #FFFFFF08 : HubTheme.surface);
    border-width: (root.is-focused || root.has-focus) ? 2px : (touch.has-hover ? 1px : 0px);
    border-color: (root.is-focused || root.has-focus) ? HubTheme.focus-ring : HubTheme.separator;
    clip: true;

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: root.artwork-height;
            background: @linear-gradient(135deg, #241628 0%, #14131b 100%);
            clip: true;

            Image {
                source: @image-url("../../../assets/icons/channels.svg");
                width: 32px;
                height: 32px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
                opacity: 0.4;
            }
        }

        VerticalLayout {
            height: 56px;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 6px;
            padding-bottom: 6px;
            spacing: 2px;
            alignment: center;

            Text {
                text: root.item.title;
                color: HubTheme.text-primary;
                font-size: HubTheme.card-title-size;
                font-weight: 600;
                horizontal-alignment: left;
                vertical-alignment: center;
                overflow: elide;
                width: 100%;
            }

            Text {
                text: "Category";
                color: HubTheme.text-muted;
                font-size: 11px;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

component DashboardSkeletonCard inherits Rectangle {
    property <length> artwork-height: min(220px, root.width * 0.5625);
    preferred-width: 240px;
    min-width: 160px;
    horizontal-stretch: 1;
    height: root.artwork-height + 70px;
    border-radius: HubTheme.card-radius;
    background: HubTheme.surface;
    border-width: 1px;
    border-color: HubTheme.separator;
    clip: true;

    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: root.artwork-height;
            background: HubTheme.surface-hover;
        }

        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            height: 82px;
            padding-top: 12px;
            spacing: 8px;
            Rectangle {
                width: 145px;
                height: 8px;
                border-radius: 3px;
                background: #F3F4F61C;
            }
            Rectangle {
                width: 82px;
                height: 6px;
                border-radius: 3px;
                background: #F3F4F612;
            }
        }
    }
}

export component DashboardShelf inherits VerticalLayout {
    in property <string> title;
    in property <[VideoCardData]> items;
    in property <string> action-label: "See all";
    in property <string> category-name: "";
    in property <bool> performer-cards: false;
    in property <string> empty-message: "";
    in property <bool> loading: false;
    in property <string> error-message: "";
    in property <length> viewport-width: 0px;
    property <int> visible-performer-count: root.viewport-width > 0px
        ? max(1, min(root.items.length, min(8, Math.floor((root.viewport-width + 16px) / 176px))))
        : min(root.items.length, 5);
    property <int> visible-video-count: root.viewport-width > 0px
        ? (root.viewport-width >= 1500px ? 6 : (root.viewport-width >= 1200px ? 5 : 4))
        : 4;
    property <length> avail-w: root.viewport-width > 0px ? root.viewport-width : 960px;
    property <int> active-video-count: max(1, min(root.items.length, root.visible-video-count));
    property <length> shelf-card-width: min(340px, max(160px, (root.avail-w - 48px - (root.active-video-count - 1) * 16px) / root.active-video-count));

    callback play-item(string);
    callback open-item(string);
    callback thumbnail-retry(VideoCardData);
    callback open-performer(string);
    callback show-all(string);
    callback retry();


        if root.items.length > 0 || root.empty-message != "" || root.loading || root.error-message != "" : VerticalLayout {
        spacing: HubTheme.space-4;

        SectionHeader {
            title: root.title;
            action-label: root.action-label;
            show-scroll-controls: false;
            action => { root.show-all(root.category-name); }
        }

        if root.error-message != "" : Rectangle {
            height: 54px;
            border-radius: 9px;
            background: HubTheme.surface;
            border-width: 0px;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 10px;
                spacing: 10px;
                alignment: center;
                Image {
                    source: @image-url("../../../assets/icons/alert.svg");
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                }
                Text {
                    text: root.error-message;
                    color: HubTheme.text-secondary;
                    font-size: HubTheme.metadata-size;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: retry-touch.has-hover ? HubTheme.surface-hover : transparent;
                    border-width: 0px;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: "Retry";
                            color: HubTheme.text-primary;
                            font-size: HubTheme.metadata-size;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                    }
                        accessible-role: button;
                        accessible-label: "Retry " + root.title;
                        accessible-action-default => { root.retry(); }
                    retry-touch := TouchArea {
                        clicked => { root.retry(); }
                    }
                }
            }
        }

        if root.items.length > 0 && root.performer-cards : HorizontalLayout {
            height: 260px;
            spacing: HubTheme.space-4;
            if root.items.length > 0 && root.visible-performer-count >= 1 : PerformerCard {
                horizontal-stretch: 1;
                fixed-width: false;
                item: root.items[0];
                clicked => { root.open-performer(root.items[0].title); }
            }
            if root.items.length > 1 && root.visible-performer-count >= 2 : PerformerCard {
                horizontal-stretch: 1;
                fixed-width: false;
                item: root.items[1];
                clicked => { root.open-performer(root.items[1].title); }
            }
            if root.items.length > 2 && root.visible-performer-count >= 3 : PerformerCard {
                horizontal-stretch: 1;
                fixed-width: false;
                item: root.items[2];
                clicked => { root.open-performer(root.items[2].title); }
            }
            if root.items.length > 3 && root.visible-performer-count >= 4 : PerformerCard {
                horizontal-stretch: 1;
                fixed-width: false;
                item: root.items[3];
                clicked => { root.open-performer(root.items[3].title); }
            }
            if root.items.length > 4 && root.visible-performer-count >= 5 : PerformerCard {
                horizontal-stretch: 1;
                fixed-width: false;
                item: root.items[4];
                clicked => { root.open-performer(root.items[4].title); }
            }
            if root.items.length > 5 && root.visible-performer-count >= 6 : PerformerCard {
                horizontal-stretch: 1;
                fixed-width: false;
                item: root.items[5];
                clicked => { root.open-performer(root.items[5].title); }
            }
            if root.items.length > 6 && root.visible-performer-count >= 7 : PerformerCard {
                horizontal-stretch: 1;
                fixed-width: false;
                item: root.items[6];
                clicked => { root.open-performer(root.items[6].title); }
            }
            if root.items.length > 7 && root.visible-performer-count >= 8 : PerformerCard {
                horizontal-stretch: 1;
                fixed-width: false;
                item: root.items[7];
                clicked => { root.open-performer(root.items[7].title); }
            }
        }

        if root.items.length > 0 && !root.performer-cards : HorizontalLayout {
            height: root.shelf-card-width * 0.5625 + 70px;
            spacing: HubTheme.space-4;
            if root.items.length > 0 : VideoCard {
                item: root.items[0];
                card-width: root.shelf-card-width;
                max-width: 340px;
                fixed-width: false;
                play => { root.play-item(root.items[0].id); }
                open-detail => { root.open-item(root.items[0].id); }
                thumbnail-retry(item) => { root.thumbnail-retry(item); }
            }
            if root.items.length > 1 : VideoCard {
                item: root.items[1];
                card-width: root.shelf-card-width;
                max-width: 340px;
                fixed-width: false;
                play => { root.play-item(root.items[1].id); }
                open-detail => { root.open-item(root.items[1].id); }
                thumbnail-retry(item) => { root.thumbnail-retry(item); }
            }
            if root.items.length > 2 : VideoCard {
                item: root.items[2];
                card-width: root.shelf-card-width;
                max-width: 340px;
                fixed-width: false;
                play => { root.play-item(root.items[2].id); }
                open-detail => { root.open-item(root.items[2].id); }
                thumbnail-retry(item) => { root.thumbnail-retry(item); }
            }
            if root.items.length > 3 : VideoCard {
                item: root.items[3];
                card-width: root.shelf-card-width;
                max-width: 340px;
                fixed-width: false;
                play => { root.play-item(root.items[3].id); }
                open-detail => { root.open-item(root.items[3].id); }
                thumbnail-retry(item) => { root.thumbnail-retry(item); }
            }
            if root.items.length > 4 && root.visible-video-count >= 5 : VideoCard {
                item: root.items[4];
                card-width: root.shelf-card-width;
                max-width: 340px;
                fixed-width: false;
                play => { root.play-item(root.items[4].id); }
                open-detail => { root.open-item(root.items[4].id); }
                thumbnail-retry(item) => { root.thumbnail-retry(item); }
            }
            if root.items.length > 5 && root.visible-video-count >= 6 : VideoCard {
                item: root.items[5];
                card-width: root.shelf-card-width;
                max-width: 340px;
                fixed-width: false;
                play => { root.play-item(root.items[5].id); }
                open-detail => { root.open-item(root.items[5].id); }
                thumbnail-retry(item) => { root.thumbnail-retry(item); }
            }
        }

        if root.items.length == 0 && root.loading : HorizontalLayout {
            height: min(302px, max(206px, min(220px, ((root.width - 32px) / 3) * 0.5625) + 70px));
            spacing: HubTheme.space-4;
            DashboardSkeletonCard { horizontal-stretch: 1; }
            DashboardSkeletonCard { horizontal-stretch: 1; }
            DashboardSkeletonCard { horizontal-stretch: 1; }
        }

        if root.items.length == 0 && !root.loading && root.error-message == "" && root.empty-message != "" : Rectangle {
            height: 54px;
            border-radius: 8px;
            background: HubTheme.surface;
            border-width: 1px;
            border-color: HubTheme.separator;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                alignment: center;

                Text {
                    text: root.empty-message;
                    color: HubTheme.text-secondary;
                    font-size: HubTheme.metadata-size;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}

import { HubTheme, KeyboardState } from "theme.slint";

// Shared controls for view components. A view owns domain behavior and binds
// these callbacks to its existing handlers.
export component Button inherits Rectangle {
    in property <string> text;
    in property <string> accessible-name: root.text;
    in property <bool> primary: false;
    in property <bool> disabled: false;
    in property <bool> loading: false;
    out property <bool> has-focus: focus-target.has-focus;
    callback clicked();

    forward-focus: focus-target;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => {
        if (!root.disabled && !root.loading) { root.clicked(); }
    }

    width: max(88px, label.preferred-width + 32px);
    height: HubTheme.control-height;
    border-radius: HubTheme.control-radius;
    border-width: root.has-focus ? 1px : 0px;
    border-color: root.has-focus ? HubTheme.focus-ring : transparent;
    background: root.disabled ? HubTheme.navigation-background
        : (touch.pressed ? HubTheme.accent-pressed
        : (touch.has-hover ? (root.primary ? HubTheme.accent-hover : HubTheme.surface-hover)
        : (root.primary ? HubTheme.accent : HubTheme.surface)));
    opacity: root.disabled ? 0.58 : 1.0;

    animate background { duration: 150ms; }

    label := Text {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.loading ? "Loading…" : root.text;
        color: HubTheme.text-primary;
        font-size: HubTheme.body-size;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        enabled: !root.disabled && !root.loading;
        clicked => { root.clicked(); }
    }

    focus-target := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (!root.disabled && !root.loading && (event.text == Key.Space || event.text == Key.Return)) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> accessible-name;
    in property <bool> disabled: false;
    out property <bool> has-focus: focus-target.has-focus;
    callback clicked();

    forward-focus: focus-target;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => {
        if (!root.disabled) { root.clicked(); }
    }

    width: 40px;
    height: 40px;
    border-radius: HubTheme.control-radius;
    border-width: root.has-focus ? 1px : 0px;
    border-color: root.has-focus ? HubTheme.focus-ring : transparent;
    background: root.disabled ? HubTheme.navigation-background
        : (touch.pressed ? HubTheme.accent-pressed : (touch.has-hover ? HubTheme.surface-hover : HubTheme.surface));
    opacity: root.disabled ? 0.58 : 1.0;

    Image {
        source: root.icon;
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }

    focus-target := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (!root.disabled && (event.text == Key.Space || event.text == Key.Return)) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

export component FilterIconButton inherits Rectangle {
    in property <bool> open: false;
    in property <bool> has-active-filters: false;
    in property <int> active-filter-count: 0;
    in property <bool> disabled: false;
    in property <string> tooltip-text: "Filters";
    in property <string> accessible-name: root.tooltip-text;
    out property <bool> has-focus: focus-target.has-focus;
    callback clicked();

    forward-focus: focus-target;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-checked: root.open;
    accessible-action-default => {
        if (!root.disabled) { root.clicked(); }
    }

    width: 44px;
    height: HubTheme.control-height;
    border-radius: HubTheme.control-radius;
    border-width: root.has-focus || root.open ? 1px : 0px;
    border-color: root.has-focus ? HubTheme.focus-ring : (root.open ? #BE185D88 : transparent);
    background: root.disabled ? HubTheme.navigation-background
        : (touch.pressed ? HubTheme.accent-pressed
        : (root.open ? #BE185D33
        : (touch.has-hover ? HubTheme.surface-hover : HubTheme.surface)));
    opacity: root.disabled ? 0.58 : 1.0;

    animate background { duration: 150ms; }

    Image {
        source: @image-url("../../../assets/icons/filter.svg");
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }

    // Subtle active filter indicator dot positioned at top-right without changing button geometry
    if (root.has-active-filters || root.active-filter-count > 0) : Rectangle {
        x: parent.width - 11px;
        y: 5px;
        width: 7px;
        height: 7px;
        border-radius: 3.5px;
        background: HubTheme.accent;
        border-width: 1px;
        border-color: #14141cf5;
    }

    if touch.has-hover && !root.disabled : Rectangle {
        y: -30px;
        x: (parent.width - self.width) / 2;
        height: 24px;
        width: tip-text.preferred-width + 16px;
        border-radius: 4px;
        background: #14141cf5;
        border-width: 1px;
        border-color: #BE185D88;
        z: 100;

        tip-text := Text {
            x: 8px;
            y: 4px;
            text: root.tooltip-text;
            color: #FFFFFF;
            font-size: 11px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.clicked(); }
    }

    focus-target := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (!root.disabled && (event.text == Key.Space || event.text == Key.Return)) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    out property <bool> has-focus: editor.has-focus;
    callback accepted();

    accessible-label: root.accessible-name;
    height: HubTheme.control-height;
    border-radius: HubTheme.control-radius;
    border-width: 1px;
    border-color: root.has-focus ? HubTheme.focus-ring : HubTheme.control-border;
    background: HubTheme.surface;

    editor := TextInput {
        x: 12px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        color: HubTheme.text-primary;
        selection-background-color: HubTheme.accent;
        font-size: HubTheme.body-size;
        vertical-alignment: center;
        accessible-label: root.accessible-name;
        changed has-focus => { KeyboardState.text-input-focused = editor.has-focus; }
        key-pressed(event) => {
            if (event.text == Key.Return) {
                root.accepted();
                return accept;
            }
            reject
        }
    }
    if root.text == "" && !root.has-focus && root.placeholder != "" : Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.placeholder;
        color: HubTheme.text-muted;
        font-size: HubTheme.body-size;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Select provides the shared closed-state appearance and activation callback;
// the owning view supplies its existing options popup and selection model.
export component Select inherits Rectangle {
    in property <string> value;
    in property <string> accessible-name;
    in property <bool> disabled: false;
    out property <bool> has-focus: focus-target.has-focus;
    callback activated();

    forward-focus: focus-target;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => { if (!root.disabled) { root.activated(); } }
    height: HubTheme.control-height;
    min-width: 140px;
    border-radius: HubTheme.control-radius;
    border-width: 1px;
    border-color: root.has-focus ? HubTheme.focus-ring : HubTheme.separator;
    background: touch.has-hover ? HubTheme.surface-hover : HubTheme.surface;
    opacity: root.disabled ? 0.58 : 1.0;

    Text {
        x: 12px;
        width: parent.width - 36px;
        height: parent.height;
        text: root.value;
        color: HubTheme.text-primary;
        font-size: HubTheme.body-size;
        vertical-alignment: center;
        overflow: elide;
    }
    Image {
        x: parent.width - 28px;
        width: 18px;
        height: parent.height;
        source: @image-url("../../../assets/icons/chevron-down.svg");
        image-fit: contain;
    }

    touch := TouchArea {
        enabled: !root.disabled;
        clicked => { root.activated(); }
    }
    focus-target := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (!root.disabled && (event.text == Key.Space || event.text == Key.Return)) {
                root.activated();
                return accept;
            }
            reject
        }
    }
}

export component NavigationItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> accessible-name: root.text;
    in property <bool> selected: false;
    in property <bool> compact: false;
    out property <bool> has-focus: focus-target.has-focus;
    callback clicked();

    forward-focus: focus-target;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => { root.clicked(); }
    height: 44px;
    min-width: root.compact ? 48px : 180px;
    border-radius: HubTheme.control-radius;
    border-width: root.has-focus ? 1px : 0px;
    border-color: root.has-focus ? HubTheme.focus-ring : transparent;
    background: root.selected ? HubTheme.surface-raised : (touch.has-hover ? HubTheme.surface-hover : transparent);

    animate background { duration: 120ms; }

    if root.selected && !root.compact : Rectangle {
        x: 0px;
        y: 11px;
        width: 3px;
        height: 22px;
        border-radius: 2px;
        background: HubTheme.accent;
    }

    Rectangle {
        x: root.compact ? (parent.width - self.width) / 2 : 12px;
        y: (parent.height - self.height) / 2;
        width: 24px;
        height: 24px;
        background: transparent;

        Image {
            source: root.icon;
            width: 20px;
            height: 20px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
        }
    }

    if !root.compact : Text {
        x: 48px;
        y: 0px;
        width: parent.width - 60px;
        height: parent.height;
        text: root.text;
        color: root.selected || root.has-focus ? HubTheme.text-primary : (touch.has-hover ? HubTheme.text-primary : HubTheme.text-secondary);
        font-size: HubTheme.body-size;
        font-weight: root.selected ? 600 : 500;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    focus-target := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

export component Tab inherits Rectangle {
    in property <string> text;
    in property <string> accessible-name: root.text;
    in property <bool> selected: false;
    out property <bool> has-focus: focus-target.has-focus;
    callback clicked();

    forward-focus: focus-target;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-action-default => { root.clicked(); }
    width: max(72px, label.preferred-width + 24px);
    height: 42px;
    border-radius: HubTheme.control-radius;
    border-width: 2px;
    border-color: root.has-focus ? HubTheme.focus-ring : transparent;
    background: touch.has-hover ? HubTheme.surface-hover : (root.selected ? #BE185D20 : transparent);

    label := Text {
        x: (parent.width - self.width) / 2;
        y: 0px;
        height: parent.height - 3px;
        text: root.text;
        color: root.selected ? HubTheme.text-primary : HubTheme.text-secondary;
        font-size: HubTheme.body-size;
        font-weight: root.selected ? 600 : 500;
        vertical-alignment: center;
    }
    Rectangle {
        x: 10px;
        y: parent.height - 3px;
        width: parent.width - 20px;
        height: 3px;
        border-radius: 2px;
        background: root.selected ? HubTheme.accent : transparent;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    focus-target := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
}

export component SectionHeader inherits HorizontalLayout {
    in property <string> title;
    in property <string> action-label: "See all";
    in property <bool> show-scroll-controls: false;
    in property <bool> scroll-left-disabled: true;
    in property <bool> scroll-right-disabled: true;
    callback action();
    callback scroll-left();
    callback scroll-right();

    height: 44px;
    spacing: HubTheme.space-2;

    Text {
        text: root.title;
        color: HubTheme.text-primary;
        font-size: HubTheme.section-title-size;
        font-weight: 600;
        vertical-alignment: center;
    }

    Rectangle { horizontal-stretch: 1; }

    if root.show-scroll-controls : IconButton {
        icon: @image-url("../../../assets/icons/chevron-left.svg");
        accessible-name: "Scroll " + root.title + " left";
        disabled: root.scroll-left-disabled;
        clicked => { root.scroll-left(); }
    }

    if root.show-scroll-controls : IconButton {
        icon: @image-url("../../../assets/icons/chevron-right.svg");
        accessible-name: "Scroll " + root.title + " right";
        disabled: root.scroll-right-disabled;
        clicked => { root.scroll-right(); }
    }

    if root.action-label != "" : Rectangle {
        width: action-text.preferred-width + 16px;
        height: 40px;
        border-radius: HubTheme.control-radius;
        background: action-touch.has-hover ? HubTheme.surface-hover : #00000000;
        action-text := Text {
            x: 8px;
            y: 0px;
            width: parent.width - 16px;
            height: parent.height;
            text: root.action-label;
            color: action-touch.has-hover ? HubTheme.text-primary : HubTheme.text-secondary;
            font-size: HubTheme.body-size;
            vertical-alignment: center;
        }
        accessible-role: button;
        accessible-label: root.action-label + " " + root.title;
        accessible-action-default => { root.action(); }
        action-touch := TouchArea {
            clicked => { root.action(); }
        }
    }
}

export component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> description: "";
    in property <string> metadata: "";

    spacing: 4px;
    alignment: start;

    HorizontalLayout {
        height: 36px;
        spacing: HubTheme.space-3;
        Text {
            text: root.title;
            color: HubTheme.text-primary;
            font-size: HubTheme.title-size;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
        }
        if root.metadata != "" : Rectangle {
            height: 24px;
            border-radius: HubTheme.control-radius;
            background: HubTheme.surface-raised;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                Text {
                    text: root.metadata;
                    color: HubTheme.text-secondary;
                    font-size: HubTheme.metadata-size;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }

    if root.description != "" : Text {
        text: root.description;
        color: HubTheme.text-secondary;
        font-size: HubTheme.body-size;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component StatusBadge inherits Rectangle {
    in property <string> text;
    in property <string> status: "neutral";
    in property <string> accessible-name: root.text;

    accessible-role: none;
    accessible-label: root.accessible-name;
    height: 24px;
    width: label.preferred-width + 16px;
    border-radius: 12px;
    border-width: 0px;
    border-color: transparent;
    background: root.status == "success" ? #75C99120
        : (root.status == "warning" ? #E8C36A20
        : (root.status == "error" ? #E9878720 : HubTheme.surface-raised));
    label := Text {
        x: 8px;
        width: parent.width - 16px;
        height: parent.height;
        text: root.text;
        color: root.status == "success" ? HubTheme.success
            : (root.status == "warning" ? HubTheme.warning
            : (root.status == "error" ? HubTheme.error : HubTheme.text-secondary));
        font-size: HubTheme.metadata-size;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component EmptyState inherits VerticalLayout {
    in property <image> icon: @image-url("../../../assets/icons/info.svg");
    in property <string> title;
    in property <string> description;
    in property <string> action-text;
    callback action();

    alignment: center;
    spacing: HubTheme.space-3;
    Rectangle {
        width: 48px;
        height: 48px;
        border-radius: 24px;
        background: HubTheme.surface-hover;
        Image {
            source: root.icon;
            width: 24px;
            height: 24px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            image-fit: contain;
        }
    }
    Text {
        text: root.title;
        color: HubTheme.text-primary;
        font-size: HubTheme.section-title-size;
        font-weight: 600;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    Text {
        text: root.description;
        color: HubTheme.text-secondary;
        font-size: HubTheme.body-size;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.action-text != "" : Button {
        text: root.action-text;
        primary: true;
        clicked => { root.action(); }
    }
}

// Invisible wheel overlay for the Ctrl+scroll card zoom. It only captures
// events while `active` (the physical Ctrl state); otherwise the wheel falls
// through to the ListView/ScrollView underneath, so plain scrolling is unchanged.
export component WheelZoomCapture inherits TouchArea {
    in property <bool> active: false;
    callback zoom-delta(float);

    enabled: root.active;

    scroll-event(event) => {
        // On Windows the native keyboard poll is authoritative. Slint's
        // ScrollEvent modifiers can still say Ctrl is up (notably for right
        // Ctrl), even while this overlay is enabled by the physical key state.
        root.zoom-delta(event.delta-y / 1px);
        EventResult.accept
    }
}

export component AccentSpinner inherits Rectangle {
    in property <length> size: 24px;
    in property <color> brush: HubTheme.accent;

    width: root.size;
    height: root.size;

    // Transforms are ignored on a component root, so rotate the inner Path.
    Path {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: "M 12 3 A 9 9 0 1 1 3 12";
        stroke: root.brush;
        stroke-width: 2.5px;
        stroke-line-cap: round;
        transform-rotation: animation-tick() / 1s * 180deg;
        transform-origin: { x: root.size / 2, y: root.size / 2 };
    }
}

export component LoadingState inherits VerticalLayout {
    in property <string> text: "Loading…";
    in property <string> description: "";
    in property <length> spinner-size: 36px;
    in property <bool> compact: false;

    alignment: center;
    spacing: root.compact ? 8px : HubTheme.space-3;

    HorizontalLayout {
        alignment: center;
        AccentSpinner {
            size: root.compact ? 22px : root.spinner-size;
        }
    }

    if root.text != "" : Text {
        text: root.text;
        color: HubTheme.text-primary;
        font-size: root.compact ? HubTheme.metadata-size : HubTheme.body-size;
        font-weight: 600;
        horizontal-alignment: center;
        wrap: word-wrap;
    }

    if root.description != "" : Text {
        text: root.description;
        color: HubTheme.text-muted;
        font-size: HubTheme.metadata-size;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

export component ErrorState inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    in property <string> retry-text: "Try again";
    in property <string> details;
    callback retry();

    alignment: center;
    spacing: HubTheme.space-3;
    StatusBadge { text: "Error"; status: "error"; }
    Text {
        text: root.title;
        color: HubTheme.text-primary;
        font-size: HubTheme.section-title-size;
        font-weight: 600;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    Text {
        text: root.description;
        color: HubTheme.text-secondary;
        font-size: HubTheme.body-size;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    Button {
        text: root.retry-text;
        primary: true;
        clicked => { root.retry(); }
    }
    if root.details != "" : Text {
        text: root.details;
        color: HubTheme.text-muted;
        font-size: HubTheme.metadata-size;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

export component Dialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> title;
    in property <string> message;
    in property <string> confirm-text: "Confirm";
    in property <string> cancel-text: "Cancel";
    in property <string> accessible-name: root.title;
    callback confirmed();
    callback cancelled();

    visible: root.open;
    z: 1000;
    width: 440px;
    height: 240px;
    border-radius: HubTheme.dialog-radius;
    border-width: 1px;
    border-color: HubTheme.separator;
    background: HubTheme.surface;
    accessible-role: groupbox;
    accessible-label: root.accessible-name;

    focus-scope := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            reject
        }
        VerticalLayout {
            padding: HubTheme.form-card-padding;
            spacing: HubTheme.space-3;
            Text {
                text: root.title;
                color: HubTheme.text-primary;
                font-size: HubTheme.section-title-size;
                font-weight: 600;
                wrap: word-wrap;
            }
            Text {
                text: root.message;
                color: HubTheme.text-secondary;
                font-size: HubTheme.body-size;
                vertical-stretch: 1;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: HubTheme.space-2;
                Button { text: root.cancel-text; clicked => { root.cancelled(); } }
                Button { text: root.confirm-text; primary: true; clicked => { root.confirmed(); } }
            }
        }
    }
}

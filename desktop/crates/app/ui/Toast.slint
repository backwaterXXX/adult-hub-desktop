export component Toast inherits Rectangle {
    in property <bool> is-open: false;
    in property <string> message: "";
    in property <string> toast-type: "info"; // "info", "warning", "error", "success"
    in property <string> action-text: "";
    callback action-clicked();
    callback dismiss();

    visible: root.is-open;
    z: 1000;
    height: 48px;
    border-radius: 8px;
    background: #141416f5;
    border-width: 1.5px;
    border-color: root.toast-type == "error" ? #e50914 : (root.toast-type == "warning" ? #ff9800 : (root.toast-type == "success" ? #4caf50 : #29b6f6));
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000088;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;
        alignment: center;

        // Compact, font-independent status mark.
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: root.toast-type == "error" ? #e5091428 : (root.toast-type == "warning" ? #ff980028 : (root.toast-type == "success" ? #4caf5028 : #29b6f628));

            Text {
                text: root.toast-type == "error" || root.toast-type == "warning" ? "!" : (root.toast-type == "success" ? "✓" : "i");
                color: root.toast-type == "error" ? #ff6670 : (root.toast-type == "warning" ? #ffbd52 : (root.toast-type == "success" ? #7bdd80 : #67cefa));
                font-size: 14px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Message
        Text {
            text: root.message;
            color: #ffffff;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        // Optional action button
        if root.action-text != "" : Rectangle {
            height: 30px;
            border-radius: 6px;
            background: root.toast-type == "error" ? #e50914 : (root.toast-type == "warning" ? #ff9800 : #29b6f6);

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: root.action-text;
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }

            accessible-role: button;
            accessible-label: root.action-text;
            accessible-action-default => { root.action-clicked(); }

            action-touch := TouchArea {
                clicked => { root.action-clicked(); }
            }
        }

        // Close button
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 14px;
            background: close-touch.has-hover ? #ffffff22 : transparent;

            Text {
                text: "✕";
                color: #888888;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            accessible-role: button;
            accessible-label: "Dismiss notification";
            accessible-action-default => { root.dismiss(); }

            close-touch := TouchArea {
                clicked => { root.dismiss(); }
            }
        }
    }
}

// Shared Adult Hub Desktop visual tokens. Keep these values centralized so
// views can use a consistent palette, spacing scale, and typography.
export global HubTheme {
    in property <color> app-background: #0B0D12;
    in property <color> navigation-background: #10141C;
    in property <color> surface: #171C26;
    in property <color> surface-hover: #202837;
    in property <color> separator: #2B3445;
    in property <color> control-border: #64748B;

    in property <color> text-primary: #F3F4F6;
    in property <color> text-secondary: #B6C0CF;
    in property <color> text-muted: #94A3B8;

    in property <color> accent: #BE185D;
    in property <color> accent-outline: #D01D68;
    in property <color> accent-text: #F9A8D4;
    in property <color> accent-hover: #D01D68;
    in property <color> accent-pressed: #9D174D;
    in property <color> focus-ring: #F9A8D4;

    in property <color> success: #4ADE80;
    in property <color> warning: #FBBF24;
    in property <color> error: #FB7185;

    in property <length> space-1: 4px;
    in property <length> space-2: 8px;
    in property <length> space-3: 12px;
    in property <length> space-4: 16px;
    in property <length> space-6: 24px;
    in property <length> space-8: 32px;
    in property <length> space-12: 48px;

    in property <length> content-padding: 24px;
    in property <length> compact-content-padding: 16px;
    in property <length> form-card-padding: 24px;
    in property <length> card-gap: 16px;
    in property <length> control-radius: 8px;
    in property <length> card-radius: 12px;
    in property <length> dialog-radius: 16px;
    in property <length> control-height: 44px;

    in property <length> title-size: 30px;
    in property <length> section-title-size: 22px;
    in property <length> card-title-size: 16px;
    in property <length> body-size: 15px;
    in property <length> metadata-size: 13px;
}

export global KeyboardState {
    in-out property <bool> text-input-focused: false;
}

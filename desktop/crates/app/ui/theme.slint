// Adult Hub Fluent 2 Dark visual foundation.
// Keep component colors and dimensions bound to these shared roles.
export global HubTheme {
    in property <color> app-background: #141414;
    in property <color> navigation-background: #191919;
    in property <color> surface: #202020;
    in property <color> surface-raised: #272727;
    in property <color> surface-hover: #303030;
    in property <color> separator: #383838;
    in property <color> control-border: #484848;

    in property <color> text-primary: #F5F5F5;
    in property <color> text-secondary: #BDBDBD;
    in property <color> text-muted: #A3A3A3;

    in property <color> accent: #C2185B;
    in property <color> accent-hover: #D11D66;
    in property <color> accent-pressed: #A3154E;
    in property <color> accent-outline: #C2185B;
    in property <color> accent-text: #F3A6C5;
    in property <color> focus-ring: #F3A6C5;

    in property <color> success: #75C991;
    in property <color> warning: #E8C36A;
    in property <color> error: #E98787;

    in property <length> space-1: 4px;
    in property <length> space-2: 8px;
    in property <length> space-3: 12px;
    in property <length> space-4: 16px;
    in property <length> space-6: 24px;
    in property <length> space-8: 32px;
    in property <length> space-12: 48px;

    in property <length> content-padding: 28px;
    in property <length> compact-content-padding: 16px;
    in property <length> form-card-padding: 24px;
    in property <length> card-gap: 16px;
    in property <length> control-radius: 6px;
    in property <length> card-radius: 10px;
    in property <length> dialog-radius: 12px;
    in property <length> control-height: 38px;

    in property <length> title-size: 28px;
    in property <length> section-title-size: 20px;
    in property <length> card-title-size: 15px;
    in property <length> body-size: 14px;
    in property <length> metadata-size: 12px;
}

export global KeyboardState {
    in-out property <bool> text-input-focused: false;
}

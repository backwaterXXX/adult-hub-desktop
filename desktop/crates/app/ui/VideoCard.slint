import { HubTheme } from "theme.slint";

export struct VideoCardData {
    id: string,
    title: string,
    genre: string,
    duration: string,
    year: string,
    is_played: bool,
    provider: string,
    is_favorite: bool,
    studio: string,
    progress: float,
    has_thumbnail: bool,
    thumbnail_state: string,
    thumbnail: image,
    card_index: int,
    thumbnail_url: string,
    fallback_thumbnail_url: string,
    alternate_thumbnail_url: string,
}

export struct VideoCardRowData {
    has_0: bool,
    card_0: VideoCardData,
    has_1: bool,
    card_1: VideoCardData,
    has_2: bool,
    card_2: VideoCardData,
    has_3: bool,
    card_3: VideoCardData,
}

export component VideoCard inherits Rectangle {
    in property <VideoCardData> item;
    in property <bool> is-focused: false;
    in property <length> card-width: 250px;
    in property <bool> fixed-width: false;
    in property <bool> retry-enabled: true;
    out property <bool> has-focus: focus-scope.has-focus;
    callback clicked();
    callback play();
    callback open-detail();
    callback thumbnail-retry(VideoCardData);

    forward-focus: focus-scope;
    accessible-role: none;

    property <length> artwork-height: min(220px, root.width * 0.5625);
    property <bool> active: root.is-focused || root.has-focus || touch.has-hover;
    property <string> source-label: root.item.studio != "" ? root.item.studio : (root.item.provider == "telegram" ? "Telegram" : (root.item.provider == "local" ? "Local" : (root.item.provider == "performer" ? "Performer" : (root.item.provider == "studio" ? "Studio" : (root.item.provider == "genre" ? "Category" : "Jellyfin")))));

    horizontal-stretch: root.fixed-width ? 0 : 1;
    preferred-width: root.card-width;
    min-width: root.fixed-width ? root.card-width : 160px;
    height: root.artwork-height + 82px;
    border-radius: HubTheme.card-radius;
    background: root.active ? HubTheme.surface-raised : transparent;
    border-width: root.has-focus ? 1px : (touch.has-hover ? 1px : 0px);
    border-color: root.has-focus ? HubTheme.focus-ring : HubTheme.separator;

    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }

    touch := TouchArea {
        accessible-role: button;
        accessible-label: root.item.title;
        accessible-action-default => { root.open-detail(); }
        clicked => { root.open-detail(); }
    }

    focus-scope := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text == Key.Space) {
                root.play();
                return accept;
            }
            if (event.text == Key.Return) {
                root.open-detail();
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        Rectangle {
            height: root.artwork-height;
            background: HubTheme.surface;
            clip: true;
            border-radius: HubTheme.card-radius;

            if root.item.has-thumbnail : Image {
                source: root.item.thumbnail;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }

            if !root.item.has-thumbnail : Rectangle {
                width: 100%;
                height: 100%;
                background: root.item.thumbnail_state == "loading" ? HubTheme.surface-raised : HubTheme.surface;

                if root.item.thumbnail_state == "loading" : Rectangle {
                    x: 12px;
                    y: parent.height - 14px;
                    width: parent.width - 24px;
                    height: 4px;
                    border-radius: 2px;
                    background: HubTheme.separator;
                    Rectangle {
                        width: parent.width * 0.42;
                        height: 100%;
                        border-radius: 2px;
                        background: HubTheme.text-muted;
                    }
                }

                Rectangle {
                    x: (parent.width - 40px) / 2;
                    y: root.item.thumbnail_state == "failed"
                        ? max(8px, (parent.height - 96px) / 2)
                        : (parent.height - 60px) / 2;
                    width: 40px;
                    height: 28px;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: HubTheme.separator;
                    background: HubTheme.surface-raised;

                    Rectangle {
                    x: 8px;
                    y: 6px;
                    width: 7px;
                    height: 7px;
                    border-radius: 4px;
                    background: HubTheme.text-muted;
                    }
                    Rectangle {
                        x: 7px;
                    y: 18px;
                    width: 24px;
                        height: 1px;
                        background: HubTheme.separator;
                    }
                }

                Text {
                    x: 8px;
                    y: root.item.thumbnail_state == "failed"
                        ? max(42px, (parent.height - 96px) / 2 + 32px)
                        : (parent.height - 60px) / 2 + 34px;
                    width: parent.width - 16px;
                    height: 16px;
                    text: root.item.thumbnail_state == "loading"
                        ? "Loading artwork…"
                        : (root.item.thumbnail_state == "failed" ? "Couldn’t load artwork" : "No artwork available");
                    color: HubTheme.text-secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if root.item.thumbnail_state == "failed" && root.retry-enabled : Rectangle {
                    x: (parent.width - 52px) / 2;
                    y: min(parent.height - 28px, max(60px, (parent.height - 96px) / 2 + 52px));
                    width: 52px;
                    height: 26px;
                    border-radius: HubTheme.control-radius;
                    background: retry-focus.has-focus ? HubTheme.surface-hover : transparent;
                    border-width: retry-focus.has-focus ? 1px : 0px;
                    border-color: HubTheme.focus-ring;
                    forward-focus: retry-focus;
                    accessible-role: button;
                    accessible-label: "Retry artwork download";
                    accessible-action-default => { root.thumbnail-retry(root.item); }

                    Text {
                        text: "Retry";
                        color: HubTheme.text-primary;
                        font-size: HubTheme.metadata-size;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    retry-touch := TouchArea {
                        clicked => { root.thumbnail-retry(root.item); }
                    }

                    retry-focus := FocusScope {
                        width: 0px;
                        height: 0px;
                        key-pressed(event) => {
                            if (event.text == Key.Return || event.text == Key.Space) {
                                root.thumbnail-retry(root.item);
                                return accept;
                            }
                            reject
                        }
                    }
                }
            }

            HorizontalLayout {
                x: 8px;
                y: 8px;
                spacing: 6px;
                alignment: start;

                if root.item.is_played || root.item.progress >= 0.90 : Rectangle {
                    width: watched-label.preferred-width + 14px;
                    height: 20px;
                    border-radius: 4px;
                    background: #000000B3;
                    border-width: 0px;

                    watched-label := Text {
                        x: 7px;
                        y: 0px;
                        width: parent.width - 14px;
                        height: parent.height;
                        text: "Watched";
                        color: #FFFFFF;
                        font-size: 10px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }

                if root.item.is_favorite : Rectangle {
                    width: fav-label.preferred-width + 14px;
                    height: 20px;
                    border-radius: 4px;
                    background: #000000B3;
                    border-width: 0px;

                    fav-label := Text {
                        x: 7px;
                        y: 0px;
                        width: parent.width - 14px;
                        height: parent.height;
                        text: "Favorite";
                        color: #FFFFFF;
                        font-size: 10px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }

            if root.item.duration != "" : Rectangle {
                width: duration-label.preferred-width + 12px;
                height: 20px;
                x: parent.width - self.width - 8px;
                y: parent.height - self.height - 8px;
                border-radius: 4px;
                background: #000000B3;
                border-width: 0px;

                duration-label := Text {
                    x: 6px;
                    y: 0px;
                    width: parent.width - 12px;
                    height: parent.height;
                    text: root.item.duration;
                    color: #FFFFFF;
                    font-size: 11px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }

            if root.active && root.item.has-thumbnail : Rectangle {
                width: 40px;
                height: 40px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: 8px;
                background: HubTheme.accent;
                border-width: 1px;
                border-color: HubTheme.focus-ring;
                accessible-role: button;
                accessible-label: "Play";
                accessible-action-default => { root.play(); }

                Image {
                    source: @image-url("../../../assets/icons/play.svg");
                    x: (parent.width - 18px) / 2;
                    y: (parent.height - 18px) / 2;
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                }

                TouchArea {
                    clicked => { root.play(); }
                }
            }

            if root.item.progress > 0.0 && !root.item.is_played && root.item.progress < 0.90 : Rectangle {
                x: 0px;
                y: parent.height - 3px;
                width: 100%;
                height: 3px;
                background: #00000088;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width * max(0.0, min(1.0, root.item.progress));
                    height: 100%;
                    background: HubTheme.accent;
                }
            }
        }

        VerticalLayout {
            height: 82px;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 8px;
            spacing: 2px;

            Text {
                text: root.item.title;
                color: HubTheme.text-primary;
                font-size: HubTheme.card-title-size;
                font-weight: 600;
                vertical-alignment: center;
                wrap: word-wrap;
                overflow: elide;
                width: 100%;
                height: 38px;
            }

            HorizontalLayout {
                height: 16px;
                spacing: 6px;

                if root.item.year != "" : Text {
                    text: root.item.year;
                    color: HubTheme.text-secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                }

                if root.item.year != "" && root.source-label != "" : Rectangle {
                    width: 3px;
                    height: 3px;
                    border-radius: 2px;
                    background: HubTheme.separator;
                }

                Text {
                    text: root.source-label;
                    color: HubTheme.text-muted;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
    }
}
